efined): boolean {\r\n        return key !== undefined && key !== null\r\n    }\r\n\r\n    function isRegistered(id: UID): boolean {\r\n        return entries[id] !== undefined\r\n    }\r\n\r\n    function isObjectRegistered(obj: object): boolean {\r\n        const entry = obj as object & Entry\r\n        const uid = entry[uidTag]\r\n\r\n        return isValid(uid) && entries[uid] === obj\r\n    }\r\n\r\n    export function register(value: any): UID {\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            const uid = obj[uidTag]\r\n\r\n            if (isValid(uid) && entries[uid] === obj) {\r\n                return uid\r\n            }\r\n\r\n            obj[uidTag] = generateUID()\r\n\r\n            entries[obj[uidTag]] = obj\r\n            return obj[uidTag]\r\n        }\r\n        const uid = generateUID()\r\n        entries[uid] = value\r\n        return uid\r\n    }\r\n\r\n    export function unregister(id: UID) {\r\n        if (!isRegistered(id)) {\r\n            return\r\n        }\r\n\r\n        const value = entries[id]\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            if (obj[uidTag] === id) {\r\n                obj[uidTag] = null\r\n            }\r\n        }\r\n\r\n        delete entries[id]\r\n    }\r\n\r\n    export function getID(obj: object): UID | undefined | null {\r\n        return (obj as Entry)[uidTag]\r\n    }\r\n\r\n    export function getValue(id: Identity): any {\r\n        if (isObject(id)) {\r\n            const objectID = (id as Entry)[uidTag]\r\n\r\n            if (!isValid(objectID)) return undefined\r\n            return entries[objectID]\r\n        }\r\n        const key = id as Key\r\n        return entries[key]\r\n    }\r\n}\r\n\r\n","advMath.ts":"interface Vector2 {\n    x: number,\n    y: number\n}\n\n\nnamespace Vector2 {\n\n    export let crossSign: Sign = 1\n\n    interface Readonly {\n        readonly x: number\n        readonly y: number\n    }\n    export const right: Readonly = { x: 1, y: 0 }\n    export const left: Readonly = { x: -1, y: 0 }\n    export const down: Readonly = { x: 0, y: 1 }\n    export const up: Readonly = { x: 0, y: -1 }\n    export const rightDown: Readonly = { x: 1, y: 1 }\n    export const rightUp: Readonly = { x: 1, y: -1 }\n    export const leftDown: Readonly = { x: -1, y: 1 }\n    export const leftUp: Readonly = { x: -1, y: -1 }\n    export const zero: Readonly = { x: 0, y: 0 }\n\n    export function create(x = 0, y = 0): Vector2 {\n        return { x, y }\n    }\n\n    export function clone(v: Vector2): Vector2 {\n        return { x: v.x, y: v.y }\n    }\n\n    export function equals(a: Vector2, b: Vector2): boolean {\n        return a.x === b.x && a.y === b.y\n    }\n\n    export function equalsApprox(\n        a: Vector2,\n        b: Vector2,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(a.x - b.x) <= tolerance &&\n            Math.abs(a.y - b.y) <= tolerance\n        )\n    }\n\n    export function equalsApproxRaw(\n        x1: number,\n        y1: number,\n        x2: number,\n        y2: number,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(x1 - x2) <= tolerance &&\n            Math.abs(y1 - y2) <= tolerance\n        )\n    }\n\n    export function multiply(v: Vector2, by: number): Vector2 {\n        return {\n            x: v.x * by,\n            y: v.y * by\n        }\n    }\n\n    export function add(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x + b.x,\n            y: a.y + b.y\n        }\n    }\n    export function subtract(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x - b.x,\n            y: a.y - b.y\n        }\n    }\n\n    export function magnitude(v: Vector2): number {\n        return magnitudeRaw(v.x, v.y)\n    }\n    export function magnitudeRaw(x: number, y: number): number {\n        return Math.sqrt(x ** 2 + y ** 2)\n    }\n\n    function magnitudeSquared(a: Vector2, b: Vector2): number {\n        const dx = a.x - b.x\n        const dy = a.y - b.y\n        return dx * dx + dy * dy\n    }\n\n    export function cross(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return crossRaw(a.x, a.y, b.x, b.y)\n    }\n    export function crossRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return crossSign * (ax * by - ay * bx)\n    }\n\n    export function dot(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return dotRaw(a.x, a.y, b.x, b.y)\n    }\n    export function dotRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return ax * bx + ay * by\n    }\n\n    export function sign(v: Vector2): Vector2 {\n        return { x: Math.sign(v.x), y: Math.sign(v.y) }\n    }\n\n    export function normalized(v: Vector2): Vector2 {\n        const mag = magnitude(v)\n        if (mag === 0) return { x: 0, y: 0 }\n        return { x: v.x / mag, y: v.y / mag }\n    }\n    export function normalizedRaw(x: number, y: number): [number, number] {\n        const magnitude = magnitudeRaw(x, y)\n        if (magnitude === 0) return [0, 0]\n        return [x / magnitude, y / magnitude]\n    }\n\n    export function normalizedSum(normals: Vector2[]): Vector2 {\n        let combined = {\n            x: 0,\n            y: 0\n        }\n\n        for (const normal of normals) {\n            combined.x += normal.x\n            combined.y += normal.y\n        }\n\n        return Vector2.normalized(combined)\n    }\n    export function applyNormalize(v: Vector2): void {\n        const mag = magnitude(v)\n        if (mag === 0) {\n            v.x = 0\n            v.y = 0\n        } else {\n            v.x /= mag\n            v.y /= mag\n        }\n    }\n    export function reversed(v: Vector2): Vector2 {\n        return { x: v.x * -1, y: v.y * -1 }\n    }\n\n    export function toStringRaw(x: number, y: number): string {\n        return `${x},${y}`\n    }\n    export function toString(v: Vector2): string {\n        return toStringRaw(v.x, v.y)\n    }\n\n    export function toLog(v: Vector2): string {\n        return `(${v.x}, ${v.y})`\n    }\n    export function toLogs(v: Vector2[]): string {\n        let logs = \"\"\n        for (const vertex of v) {\n            logs = logs.concat(`${toLog(vertex)} `)\n        }\n        return logs\n    }\n    export type Direction =\n        | \"right\" | \"left\" | \"up\"\n        | \"down\" | \"rightUp\" | \"leftUp\"\n        | \"rightDown\" | \"leftDown\"\n        ;\n    export function toDirectionString(v: Vector2): Direction {\n        const x = Math.sign(v.x), y = Math.sign(v.y)\n        if (x === 0 && y === 0) return \"down\"\n        const hDir = x === 1 ? \"right\" : x === -1 ? \"left\" : \"\"\n        let vDir = y === 1 ? \"down\" : y === -1 ? \"up\" : \"\"\n        if (hDir !== \"\" && vDir !== \"\")\n            vDir = vDir.charAt(0).toUpperCase() + vDir.slice(1)\n        return (hDir + vDir || \"down\") as Direction\n    }\n}\n\ninterface Segment {\n    start: Vector2\n    end: Vector2\n    vector: Vector2\n    length: number\n    lengthSquared: number\n    bounds: Bounds\n    sign: number // what is this for?\n}\nnamespace Segment {\n    const EPSILON = 0.001\n\n    // Optimized\n    export function create(\n        start: Vector2,\n        end: Vector2\n    ): Segment {\n\n        const dx = end.x - start.x\n        const dy = end.y - start.y\n\n        const lengthSquared =\n            dx ** 2 +\n            dy ** 2\n\n        return {\n            start,\n            end,\n\n            vector: {\n                x: dx,\n                y: dy\n            },\n\n            length: Math.sqrt(lengthSquared),\n\n            lengthSquared,\n\n            bounds: {\n                minX: Math.min(start.x, end.x),\n                maxX: Math.max(start.x, end.x),\n                minY: Math.min(start.y, end.y),\n                maxY: Math.max(start.y, end.y)\n            },\n            sign: Math.sign(dy)\n        }\n    }\n\n    export function pointAt(segment: Segment, along: number): Vector2 {\n        return {\n            x: segment.start.x + segment.vector.x * along,\n            y: segment.start.y + segment.vector.y * along\n        }\n    }\n\n    export function getAlong(\n        segment: Segment,\n        point: Vector2\n    ): number {\n        const dx = point.x - segment.start.x\n        const dy = point.y - segment.start.y\n\n        return (\n            dx * segment.vector.x +\n            dy * segment.vector.y\n        ) / segment.lengthSquared\n    }\n\n    // consider rename\n    export function containsPoint(\n        point: Vector2,\n        edge: Segment\n    ): boolean {\n\n        const along =\n            getAlong(edge, point)\n\n        if (\n            along < -EPSILON ||\n            along > 1 + EPSILON\n        ) {\n            return false\n        }\n\n        const projected =\n            pointAt(\n                edge,\n                along\n            )\n\n        return (\n            Math.abs(\n                projected.x - point.x\n            ) <= EPSILON &&\n            Math.abs(\n                projected.y - point.y\n            ) <= EPSILON\n        )\n    }\n    // Optimized: Could be in a segment math namespace\n    export function getRayIntersection(\n        rayStart: Vector2,\n        rayDirection: Vector2,\n        segment: Segment\n    ): number | undefined {\n\n        const toSegmentX = segment.start.x - rayStart.x\n        const toSegmentY = segment.start.y - rayStart.y\n\n        const cross =\n            rayDirection.x * segment.vector.y -\n            rayDirection.y * segment.vector.x\n\n        if (Math.abs(cross) <= EPSILON) {\n            return undefined\n        }\n\n        const t =\n            (\n                toSegmentX * segment.vector.y -\n                toSegmentY * segment.vector.x\n            ) / cross\n\n        if (t < 0) {\n            return undefined\n        }\n\n        const u =\n            (\n                toSegmentX * rayDirection.y -\n                toSegmentY * rayDirection.x\n            ) / cross\n\n        if (u < 0 || u > 1) {\n            return undefined\n        }\n\n        return t\n    }\n\n    export enum Side {\n        Left,\n        Right\n    }\n\n    // Optimized\n    export function getNormal(\n        segment: Segment,\n        side: Side\n    ): Vector2 {\n        const sign = side === Side.Left ? 1 : -1\n\n        return {\n            x: segment.vector.y * sign / segment.length,\n            y: -segment.vector.x * sign / segment.length\n        }\n    }\n\n    // Optimized: Could be it's own segment Math\n    export function getNormals(\n        segments: Segment[],\n        side: Side\n    ): Vector2[] {\n\n        const normals: Vector2[] = []\n\n        for (const segment of segments) {\n            normals.push(getNormal(segment, side))\n        }\n        return normals\n    }\n\n    export function toLog(segment: Segment): string {\n        const vertices = `Vertices: ${Vector2.toLog(segment.start)} -> ${Vector2.toLog(segment.end)}`\n        const vector = ` | Vector: ${Vector2.toLog(segment.vector)}`\n        const length = ` | length: ${segment.length}, lengthSquared: ${segment.lengthSquared}`\n        const sign = ` | Sign: ${segment.sign}`\n        const bounds = \" | Bounds; \" + Bounds.toLog(segment.bounds)\n        return vertices + vector + length + bounds\n    }\n}\ninterface Bounds {\n    minX: number\n    maxX: number\n    minY: number\n    maxY: number\n}\nnamespace Bounds {\n    export function clone(bounds: Bounds): Bounds {\n        return {\n            minX: bounds.minX,\n            maxX: bounds.maxX,\n            minY: bounds.minY,\n            maxY: bounds.maxY\n        }\n    }\n    export function toLog(bounds: Bounds): string {\n        return `minX: ${bounds.minX}, maxX: ${bounds.maxX}, minY: ${bounds.minY}, maxY: ${bounds.maxY}`\n    }\n}\ninterface Edge extends Segment {\n    index: number\n    startIndex: number\n    endIndex: number\n    normal: Vector2\n}\nnamespace Edge {\n\n    enum Winding {\n        Clockwise,\n        CounterClockwise\n    }\n    export function getWinding(edges: Edge[]): Winding {\n\n        let area = 0\n\n        for (const edge of edges) {\n            area +=\n                edge.start.x * edge.end.y -\n                edge.end.x * edge.start.y\n        }\n\n        return area < 0\n            ? Winding.Clockwise\n            : Winding.CounterClockwise\n    }\n\n    export function create(\n        start: Vector2,\n        end: Vector2,\n        startIndex: number,\n        endIndex: number,\n        index: number,\n        winding: Winding = Winding.Clockwise\n    ): Edge {\n        const segment = Segment.create(start, end)\n        //console.log(getSegmentNormal(segment, Side.Left))\n        return {\n            start: segment.start,\n            end: segment.end,\n            vector: segment.vector,\n            length: segment.length,\n            lengthSquared: segment.lengthSquared,\n            bounds: segment.bounds,\n            sign: segment.sign,\n            index,\n            startIndex,\n            endIndex,\n            normal: Segment.getNormal(\n                segment,\n                winding === Winding.Clockwise\n                    ? Segment.Side.Left\n                    : Segment.Side.Right\n            )\n        }\n    }\n\n    export function clone(edge: Edge, start: Vector2, end: Vector2): Edge {\n        //const start = startRef === undefined ? Vector2.clone(edge.start) : startRef\n        //const end = endRef === undefined ? Vector2.clone(edge.end) : endRef\n        //const vector = {x: end.x - start.x,y: end.y - start.y}\n\n        const newEdge = {\n            start,\n            end,\n            vector: Vector2.clone(edge.vector),\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: Bounds.clone(edge.bounds),\n            sign: edge.sign,\n            index: edge.index,\n            startIndex: edge.startIndex,\n            endIndex: edge.endIndex,\n            normal: Vector2.clone(edge.normal)\n        }\n        return newEdge\n    }\n\n    export function createFromVertices(\n        vertices: Vector2[]\n    ): Edge[] {\n\n        const edges: Edge[] = []\n\n        for (let i = 0; i < vertices.length; i++) {\n            const startIndex = i\n            const endIndex = (i + 1) % vertices.length\n\n            edges.push(\n                create(\n                    vertices[startIndex],\n                    vertices[endIndex],\n                    startIndex,\n                    endIndex,\n                    startIndex\n                )\n            )\n        }\n\n        return edges\n    }\n    export function reverse(edge: Edge): Edge {\n        return {\n            index: edge.index,\n            start: edge.end,\n            end: edge.start,\n\n            vector: {\n                x: -edge.vector.x,\n                y: -edge.vector.y\n            },\n\n            startIndex: edge.endIndex,\n            endIndex: edge.startIndex,\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: edge.bounds,\n            sign: -edge.sign,\n\n            normal: {\n                x: -edge.normal.x,\n                y: -edge.normal.y\n            }\n        }\n    }\n    export function toLog(edge: Edge): string {\n        const segmentInfo = Segment.toLog(edge)\n\n        const index = ` | StartIndex: ${edge.startIndex}, EndIndex: ${edge.endIndex}`\n        const normal = ` | Normal: ${Vector2.toLog(edge.normal)}`\n        return segmentInfo + index + normal\n    }\n    export function toLogs(edges: Edge[]): string {\n        let logs = \"\"\n        for (const edge of edges) {\n            logs = logs.concat(toLog(edge))\n        }\n\n        return logs\n    }\n}\ntype PointGroup = {\n    direction: Vector2\n    points: Vector2[]\n}\n\ntype PolyBounds = Bounds & {\n    boundPoints: PointGroup[]\n}\ninterface Polygon {\n    vertices: Vector2[]\n    origin: Vector2\n    edges: Edge[]\n    bounds: PolyBounds\n}\nnamespace Polygon {\n\n    // POLYGON CREATION \n\n    /**\n     * Creates a regular convex polygon centered at the origin.\n     * Vertices are evenly distributed around the given radius.\n     * Defaults to an upward-facing orientation.\n     */\n    const UP_ANGLE: number = -Math.PI / 2\n    export function create(\n        sides: number,\n        radius: number,\n        rotation?: number,\n        origin: Vector2 = null\n    ): Polygon {\n        if (rotation === undefined) {\n            rotation = UP_ANGLE\n        }\n\n        const verticies: Vector2[] = []\n\n        const angleStep = (Math.PI * 2) / sides\n\n        for (let i = 0; i < sides; i++) {\n            const angle = rotation + i * angleStep\n\n            verticies.push({\n                x: Math.cos(angle) * radius,\n                y: Math.sin(angle) * radius\n            })\n        }\n\n        return createFromVertices(verticies, origin)\n    }\n\n    /**\n     * Creates a polygon from an array of vertices.\n     * Vertices are connected in the order provided,\n     * regardless of their positions.\n     *\n     * Winding direction is determined by vertex order.\n     * Can create concave or self-intersecting polygons.\n     */\n    export function createFromVertices(vertices: Vector2[], origin: Vector2 = null): Polygon {\n        const edges = Edge.createFromVertices(vertices)\n        const bounds = getBounds(vertices)\n        if (!origin) origin = { x: 0, y: 0 }\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function clone(polygon: Polygon): Polygon {\n        let vertices: Vector2[] = []\n        for (let v = 0; v < polygon.vertices.length; v++) {\n            const vertex = polygon.vertices[v]\n            vertices[v] = { x: vertex.x, y: vertex.y }\n        }\n        let edges: Edge[] = []\n        for (let e = 0; e < polygon.edges.length; e++) {\n            const edge = polygon.edges[e]\n            edges.push(Edge.clone(edge, vertices[edge.startIndex], vertices[edge.endIndex]))\n        }\n\n        const bounds = getBounds(vertices)\n        const origin = Vector2.clone(polygon.origin)\n\n        //return polygon\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function createTriangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: 0, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createRectangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w, y: -h },\n            { x: w, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createOctagon(\n        width: number = 16,\n        height: number = 16,\n        cut: number = 3,\n        origin: Vector2 = null\n    ): Polygon {\n\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w + cut, y: -h },\n            { x: w - cut, y: -h },\n            { x: w, y: -h + cut },\n            { x: w, y: h - cut },\n            { x: w - cut, y: h },\n            { x: -w + cut, y: h },\n            { x: -w, y: h - cut },\n            { x: -w, y: -h + cut }\n        ], origin)\n    }\n\n    // POLYGON BOUNDS \n\n\n\n    export function getBounds(vertices: Vector2[]): PolyBounds {\n        let minX = vertices[0].x\n        let maxX = vertices[0].x\n        let minY = vertices[0].y\n        let maxY = vertices[0].y\n\n        let minXPoints = [vertices[0]]\n        let maxXPoints = [vertices[0]]\n        let minYPoints = [vertices[0]]\n        let maxYPoints = [vertices[0]]\n\n        for (let i = 1; i < vertices.length; i++) {\n            const point = vertices[i]\n\n            if (point.x < minX) {\n                minX = point.x\n                minXPoints = [point]\n            } else if (point.x == minX) {\n                minXPoints.push(point)\n            }\n\n            if (point.x > maxX) {\n                maxX = point.x\n                maxXPoints = [point]\n            } else if (point.x == maxX) {\n                maxXPoints.push(point)\n            }\n\n            if (point.y < minY) {\n                minY = point.y\n                minYPoints = [point]\n            } else if (point.y == minY) {\n                minYPoints.push(point)\n            }\n\n            if (point.y > maxY) {\n                maxY = point.y\n                maxYPoints = [point]\n            } else if (point.y == maxY) {\n                maxYPoints.push(point)\n            }\n        }\n\n        return {\n            minX,\n            maxX,\n            minY,\n            maxY,\n\n            boundPoints: [\n                {\n                    direction: { x: -1, y: 0 },\n                    points: minXPoints\n                },\n                {\n                    direction: { x: 1, y: 0 },\n                    points: maxXPoints\n                },\n                {\n                    direction: { x: 0, y: -1 },\n                    points: minYPoints\n                },\n                {\n                    direction: { x: 0, y: 1 },\n                    points: maxYPoints\n                }\n            ]\n        }\n    }\n\n    // POLYGON OPERATIONS\n\n    export function getWidth(vertices: Vector2[]): number {\n        let minX = Infinity\n        let maxX = -Infinity\n\n        for (const vertex of vertices) {\n            minX = Math.min(minX, vertex.x)\n            maxX = Math.max(maxX, vertex.x)\n        }\n\n        return maxX - minX\n    }\n\n    export function getHeight(vertices: Vector2[]): number {\n        let minY = Infinity\n        let maxY = -Infinity\n\n        for (const vertex of vertices) {\n            minY = Math.min(minY, vertex.y)\n            maxY = Math.max(maxY, vertex.y)\n        }\n\n        return maxY - minY\n    }\n\n    export function getArea(vertices: Vector2[]): number {\n        let area = 0\n\n        for (let i = 0; i < vertices.length; i++) {\n            const a = vertices[i]\n            const b = vertices[\n                (i + 1) % vertices.length\n            ]\n\n            area +=\n                a.x * b.y -\n                b.x * a.y\n        }\n\n        return Math.abs(area) * 0.5\n    }\n\n    export function getDepth(\n        verticesA: Vector2[],\n        verticesB: Vector2[],\n        direction: Vector2\n    ): number {\n        let minA =\n            Vector2.dot(\n                verticesA[0],\n                direction\n            )\n\n        let maxB =\n            Vector2.dot(\n                verticesB[0],\n                direction\n            )\n\n        for (let i = 1; i < verticesA.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesA[i],\n                    direction\n                )\n\n            if (projection < minA) {\n                minA = projection\n            }\n        }\n\n        for (let i = 1; i < verticesB.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesB[i],\n                    direction\n                )\n\n            if (projection > maxB) {\n                maxB = projection\n            }\n        }\n\n\n        return Math.abs(maxB - minA)\n    }\n\n    // TRANSLATE OPERATIONS\n\n    /**\n     * translates/mutates a polygon to a position\n     */\n    export function translateTo(polygon: Polygon, position: Vector2) {\n        const delta = Vector2.subtract(position, polygon.origin)\n        translate(polygon, delta)\n    }\n\n    /**\n     * translates/mutates a polygon by a delta\n     */\n    export function translate(polygon: Polygon, delta: Vector2) {\n        polygon.origin.x += delta.x\n        polygon.origin.y += delta.y\n\n        for (let vertex of polygon.vertices) {\n            vertex.x += delta.x\n            vertex.y += delta.y\n        }\n\n        for (let edge of polygon.edges) {\n            edge.bounds.minX += delta.x\n            edge.bounds.maxX += delta.x\n            edge.bounds.minY += delta.y\n            edge.bounds.maxY += delta.y\n        }\n\n        const bounds = polygon.bounds\n\n        bounds.minX += delta.x\n        bounds.maxX += delta.x\n        bounds.minY += delta.y\n        bounds.maxY += delta.y\n    }\n\n    /**\n     * Returns a new polygon translated by a delta\n     */\n    export function translated(polygon: Polygon, delta: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translate(newPolygon, delta)\n        return newPolygon\n    }\n    /**\n     * Returns a new polygon translated to a position\n     */\n    export function translatedTo(polygon: Polygon, position: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translateTo(newPolygon, position)\n        return newPolygon\n    }\n\n    // LOG OPERATIONS\n\n    export function logBounds(shapeName: string, thisBounds: PolyBounds) {\n        console.log(\n            \"BoundingBox \" + shapeName + \": (\" +\n            thisBounds.minX + \", \" +\n            thisBounds.minY + \") -> (\" +\n            thisBounds.maxX + \", \" +\n            thisBounds.maxY + \")\"\n        )\n        console.log(\n            \" BoundPoints \" + shapeName + \": \"\n        )\n        for (let i = 0; i < thisBounds.boundPoints.length; i++) {\n            let data = \"\"\n            for (let j = 0; j < thisBounds.boundPoints[i].points.length; j++) {\n                const bound = thisBounds.boundPoints[i]\n                data = data.concat(\n                    \" point \" + j + \": \" + Vector2.toString(bound.points[j])\n                )\n            }\n            console.log(i + \": \" + data)\n        }\n    }\n\n    export function toLog(polygon: Polygon): string {\n        const vertices = \" Vertices: \" + Vector2.toLogs(polygon.vertices)\n        const origin = \" | origin: \" + Vector2.toLog(polygon.origin)\n        const edges = \" | Edges: \" + Edge.toLogs(polygon.edges)\n        const bounds = \" | Bounds: \" + Bounds.toLog(polygon.bounds)\n        return vertices + origin + edges + bounds\n    }\n}\ninterface AABB {\n    min: Vector2\n    max: Vector2\n}\ninterface Circle {\n    center: Vector2\n    radius: number\n}\nnamespace Circle {\n    export function create(center: Vector2, radius: number): Circle {\n        return {\n            center,\n            radius\n        }\n    }\n\n    export function containsPoint(circle: Circle, point: Vector2): boolean {\n        const dx = point.x - circle.center.x\n        const dy = point.y - circle.center.y\n\n        return dx ** 2 + dy ** 2 <= circle.radius ** 2\n    }\n\n    export function intersects(a: Circle, b: Circle): boolean {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n        const radius = a.radius + b.radius\n\n        return dx ** 2 + dy ** 2 <= radius ** 2\n    }\n\n    export function getMidpoint(a: Circle, b: Circle): Vector2 | null {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distanceSquared = dx ** 2 + dy ** 2\n        const radius = a.radius + b.radius\n        if (distanceSquared > radius ** 2) {\n            return null\n        }\n\n        return {\n            x: (a.center.x + b.center.x) / 2,\n            y: (a.center.y + b.center.y) / 2\n        }\n    }\n\n    export function getPenetration(a: Circle, b: Circle): number {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx * dx + dy * dy)\n\n        return Math.max(0, a.radius + b.radius - distance)\n    }\n    function getPoints(radius: number): Vector2[] {\n        const points: Vector2[] = []\n\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            points.push({\n                x: Math.cos(radians) * radius,\n                y: Math.sin(radians) * radius\n            })\n        }\n\n        return points\n    }\n    export function getNormal(\n        a: Circle,\n        b: Circle\n    ): Vector2 {\n\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx ** 2 + dy ** 2)\n        if (distance === 0) {\n            return { x: 1, y: 0 }\n        }\n\n        return {\n            x: dx / distance,\n            y: dy / distance\n        }\n    }\n\n    export function getBounds(circle: Circle): AABB {\n        return {\n            min: {\n                x: circle.center.x - circle.radius,\n                y: circle.center.y - circle.radius\n            },\n            max: {\n                x: circle.center.x + circle.radius,\n                y: circle.center.y + circle.radius\n            }\n        }\n    }\n}\n\n","test.ts":"// Add your code here\nlet circles: Circle[] = []\nlet circleVs: Vector2[] = []\nlet rendered = 0\nfunction MakeCircle() {\n    let circle = Circle.create({ x: 1, y: 1 }, 2)\n    circles.push(circle)\n    circleVs.push(Vector2.create(20, 0))\n\n    scene.createRenderable(0, () => {\n        screen.setPixel(circle.center.x, circle.center.y, 1)\n    })\n    if (rendered >= 0) return\n    rendered++\n    scene.createRenderable(0, () => {\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            const x = circle.center.x + circle.radius * Math.cos(radians)\n            const y = circle.center.y + circle.radius * Math.sin(radians)\n\n            screen.setPixel(Math.floor(x), Math.floor(y), 1)\n        }\n    })\n}\n\n\n\nfunction CircleTest() {\n    game.stats = true\n    let count = 0\n    const display = sprites.create(assets.image`blank`)\n    display.x = 100\n    display.y = 40\n    game.onUpdateInterval(500, function () {\n        MakeCircle()\n        count++\n        display.sayText(count.toString())\n    })\n\n    const gravity = 300\n\n    game.onUpdate(function () {\n        const dt = Time.delta\n\n        for (let i = 0; i < circles.length; i++) {\n\n            const circle = circles[i]\n            const velocity = circleVs[i]\n\n            velocity.y += gravity * dt\n\n            const position = circle.center\n\n            position.x += velocity.x * dt\n            position.y += velocity.y * dt\n\n\n        }\n    })\n    const iterations = 6\n    game.onUpdate(function () {\n        for (let iteration = 0; iteration < iterations; iteration++) {\n            for (let i = 0; i < circles.length; i++) {\n                const circle = circles[i]\n                const velocity = circleVs[i]\n                const position = circle.center\n\n                // Screen boundaries\n                if (position.x < circle.radius) {\n                    position.x = circle.radius\n                    if (velocity.x < 0) velocity.x *= -0.5\n                }\n                else if (position.x > 160 - circle.radius) {\n                    position.x = 160 - circle.radius\n                    if (velocity.x > 0) velocity.x *= -0.5\n                }\n\n                if (position.y < circle.radius) {\n                    position.y = circle.radius\n                    if (velocity.y < 0) velocity.y *= -0.5\n                }\n                else if (position.y > 120 - circle.radius) {\n                    position.y = 120 - circle.radius\n                    if (velocity.y > 0) velocity.y *= -0.5\n                }\n\n                // Circle collisions\n                for (let j = i + 1; j < circles.length; j++) {\n                    const otherCircle = circles[j]\n                    const otherVelocity = circleVs[j]\n\n                    const pen = Circle.getPenetration(circle, otherCircle)\n                    if (pen <= 0) continue\n\n                    const dir = Circle.getNormal(circle, otherCircle)\n                    const correction = pen * 0.5\n\n                    circle.center.x -= dir.x * correction\n                    circle.center.y -= dir.y * correction\n                    otherCircle.center.x += dir.x * correction\n                    otherCircle.center.y += dir.y * correction\n\n                    // Velocity response\n                    const rvx = otherVelocity.x - velocity.x\n                    const rvy = otherVelocity.y - velocity.y\n                    const alongNormal = rvx * dir.x + rvy * dir.y\n\n                    if (alongNormal < 0) {\n                        const impulse = -(1 + 0.5) * alongNormal * 0.5\n\n                        velocity.x -= impulse * dir.x\n                        velocity.y -= impulse * dir.y\n\n                        otherVelocity.x += impulse * dir.x\n                        otherVelocity.y += impulse * dir.y\n                    }\n                }\n            }\n        }\n    })\n}\n\nCircleTest()","pxt.json":"{\n    \"name\": \"TSKit\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"core.ts\",\n        \"advMath.ts\",\n        \"test.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794520015392,"editorVersion":"4.1.27","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block></xml>","main.ts":"\n","README.md":" ","assets.json":"","core.ts":"\r\n// TYPES\r\ntype Key = number | string\r\ntype Identity = Key | object\r\ntype Primitive = number | string | boolean | null\r\ntype Sign = 1 | -1\r\n\r\ninterface Dictionary<T> {\r\n    [key: string]: T\r\n}\r\ninterface ManagedReference<T> {\r\n    value: T | undefined\r\n}\r\ninterface ValidityProvider<T> {\r\n    isValid(object: T): boolean\r\n}\r\ninterface CoordinateConfig {\r\n    originX: number\r\n    originY: number\r\n    axisX: Sign\r\n    axisY: Sign\r\n}\r\nnamespace Object {\r\n\r\n    /**\r\n     * EXPERIMENTAL\r\n     *\r\n     * Returns a deep clone of a value.\r\n     * Recursively clones arrays and objects, including their nested values.\r\n     *\r\n     * Does not preserve shared references or support circular references.\r\n     */\r\n    export function deepClone<T>(value: T): T {\r\n        const originals: any[] = []\r\n        const clones: any[] = []\r\n\r\n        return <T><any>cloneRecursive(value, originals, clones)\r\n    }\r\n\r\n    function cloneRecursive(\r\n        value: any,\r\n        originals: any[],\r\n        clones: any[]\r\n    ): any {\r\n        if (value === null || typeof value !== \"object\") {\r\n            return value\r\n        }\r\n\r\n        // Return an existing clone if this object was already visited.\r\n        for (let i = 0; i < originals.length; i++) {\r\n            if (originals[i] === value) {\r\n                return clones[i]\r\n            }\r\n        }\r\n\r\n        let result: any\r\n\r\n        if (Array.isArray(value)) {\r\n            result = []\r\n        } else {\r\n            result = {}\r\n        }\r\n\r\n        // Register before cloning children to handle circular references.\r\n        originals.push(value)\r\n        clones.push(result)\r\n\r\n        if (Array.isArray(value)) {\r\n            for (let i = 0; i < value.length; i++) {\r\n                result.push(cloneRecursive(value[i], originals, clones))\r\n            }\r\n        } else {\r\n            const keys = Object.keys(value)\r\n\r\n            for (let i = 0; i < keys.length; i++) {\r\n                const key = keys[i]\r\n                result[key] = cloneRecursive(value[key], originals, clones)\r\n            }\r\n        }\r\n\r\n        return result\r\n    }\r\n}\r\n\r\nnamespace Identity {\r\n\r\n    export const uidTag = \"__UID\"\r\n    export type UID = number & {\r\n        _brand: \"IdentityID\"\r\n    }\r\n\r\n    interface Entry { __UID?: UID | null }\r\n\r\n    let nextUID = 0\r\n    function generateUID(): UID {\r\n        return nextUID++ as UID\r\n    }\r\n\r\n    let entries: Dictionary<object | Primitive> = {}\r\n\r\n    function isObject(value: any): boolean {\r\n        return value !== undefined && value !== null && typeof value === \"object\"\r\n    }\r\n\r\n    function isValid(key: Key | null | undefined): boolean {\r\n        return key !== undefined && key !== null\r\n    }\r\n\r\n    function isRegistered(id: UID): boolean {\r\n        return entries[id] !== undefined\r\n    }\r\n\r\n    function isObjectRegistered(obj: object): boolean {\r\n        const entry = obj as object & Entry\r\n        const uid = entry[uidTag]\r\n\r\n        return isValid(uid) && entries[uid] === obj\r\n    }\r\n\r\n    export function register(value: any): UID {\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            const uid = obj[uidTag]\r\n\r\n            if (isValid(uid) && entries[uid] === obj) {\r\n                return uid\r\n            }\r\n\r\n            obj[uidTag] = generateUID()\r\n\r\n            entries[obj[uidTag]] = obj\r\n            return obj[uidTag]\r\n        }\r\n        const uid = generateUID()\r\n        entries[uid] = value\r\n        return uid\r\n    }\r\n\r\n    export function unregister(id: UID) {\r\n        if (!isRegistered(id)) {\r\n            return\r\n        }\r\n\r\n        const value = entries[id]\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            if (obj[uidTag] === id) {\r\n                obj[uidTag] = null\r\n            }\r\n        }\r\n\r\n        delete entries[id]\r\n    }\r\n\r\n    export function getID(obj: object): UID | undefined | null {\r\n        return (obj as Entry)[uidTag]\r\n    }\r\n\r\n    export function getValue(id: Identity): any {\r\n        if (isObject(id)) {\r\n            const objectID = (id as Entry)[uidTag]\r\n\r\n            if (!isValid(objectID)) return undefined\r\n            return entries[objectID]\r\n        }\r\n        const key = id as Key\r\n        return entries[key]\r\n    }\r\n}\r\nnamespace Time {\r\n    export let Log = false\r\n    export let deltaMillis = 0\r\n    export let delta = 0\r\n    export let updates = 0\r\n    export let updateStart = 0\r\n    export let lastReport = updates\r\n\r\n    // Microseconds\r\n    export let microsBits = 30\r\n    export let microsMax = 2 ** microsBits - 1\r\n    export let microsRollOver = microsMax + 1\r\n\r\n    export interface Profile {\r\n        name: string\r\n\r\n        // per call \r\n        start: number\r\n        minMicrosPerCall: number\r\n        maxMicrosPerCall: number\r\n\r\n        // this update\r\n        callsThisUpdate: number\r\n        microsThisUpdate: number\r\n        iterationsThisUpdate: number\r\n\r\n        // per update\r\n        minCalls: number\r\n        maxCalls: number\r\n        minMicrosPerUpdate: number\r\n        maxMicrosPerUpdate: number\r\n        minIterationsPerUpdate: number\r\n        maxIterationsPerUpdate: number\r\n\r\n        // totals\r\n        totalUpdates: number\r\n        totalCalls: number\r\n        totalMicros: number\r\n        totalIterations: number\r\n    }\r\n\r\n    export let profiles: Dictionary<Profile> = {}\r\n    export function createProfile(name: string): Profile {\r\n        return {\r\n            name: name,\r\n            start: 0,\r\n            callsThisUpdate: 0,\r\n            microsThisUpdate: 0,\r\n            iterationsThisUpdate: 0,\r\n\r\n            minMicrosPerCall: Infinity,\r\n            maxMicrosPerCall: 0,\r\n\r\n            totalUpdates: 0,\r\n            totalCalls: 0,\r\n            totalMicros: 0,\r\n            totalIterations: 0,\r\n\r\n            minCalls: Infinity,\r\n            maxCalls: 0,\r\n            minMicrosPerUpdate: Infinity,\r\n            maxMicrosPerUpdate: 0,\r\n            minIterationsPerUpdate: Infinity,\r\n            maxIterationsPerUpdate: 0,\r\n        }\r\n    }\r\n    export function getProfile(name: string): Profile {\r\n\r\n        if (profiles[name]) return profiles[name]\r\n\r\n        const profile: Profile = createProfile(name)\r\n\r\n        profiles[name] = profile\r\n        return profile\r\n    }\r\n\r\n    export function countIterations(name: string, count: number) {\r\n        getProfile(name).iterationsThisUpdate += count\r\n    }\r\n\r\n    export function resetProfile() {\r\n        profiles = {}\r\n    }\r\n    export function update(deltaMillisP: number, deltaP: number) {\r\n        deltaMillis = deltaMillisP\r\n        delta = deltaP\r\n    }\r\n    export function reportProfiles(timeMillis: number): string | undefined {\r\n        if (!Log) return undefined\r\n        let logs = \"\"\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            const profileName = profile.name\r\n            const perCall = \" === Per Call\" +\r\n                \" | Avg ms: \" + profile.totalMicros / profile.totalCalls / 1000 +\r\n                \" | Min ms: \" + profile.minMicrosPerCall / 1000 +\r\n                \" | Max ms: \" + profile.maxMicrosPerCall / 1000\r\n            const perUpdate = \" === Per Update\" +\r\n                \" | Avg Calls: \" + profile.totalCalls / profile.totalUpdates +\r\n                \" | Min Calls: \" + profile.minCalls +\r\n                \" | Max Calls: \" + profile.maxCalls +\r\n                \" | Avg ms: \" + profile.totalMicros / profile.totalUpdates / 1000 +\r\n                \" | Min ms: \" + profile.minMicrosPerUpdate / 1000 +\r\n                \" | Max ms: \" + profile.maxMicrosPerUpdate / 1000\r\n            const log = `\r\n            ${profileName} \r\n            ${perCall} \r\n            ${perUpdate}`\r\n            logs = logs.concat(log)\r\n        }\r\n        lastReport = timeMillis\r\n        return logs\r\n    }\r\n\r\n    export function startProfile(name: string, timeMicros: number) {\r\n        let profile = getProfile(name)\r\n        profile.callsThisUpdate++\r\n        profile.start = timeMicros\r\n    }\r\n\r\n    export function endProfile(name: string, timeMicros: number) {\r\n        let profile = getProfile(name)\r\n        let elapsedMicros = timeMicros - profile.start\r\n\r\n        // Handle timer wrapping around\r\n        if (elapsedMicros < 0) {\r\n            elapsedMicros += microsRollOver\r\n        }\r\n        if (elapsedMicros < profile.minMicrosPerCall || profile.minMicrosPerCall == 0) {\r\n            profile.minMicrosPerCall = elapsedMicros\r\n        }\r\n        if (elapsedMicros > profile.maxMicrosPerCall) {\r\n            profile.maxMicrosPerCall = elapsedMicros\r\n        }\r\n        profile.microsThisUpdate += elapsedMicros\r\n        profile.start = 0\r\n    }\r\n\r\n    export function beginUpdate(timeMicros: number) {\r\n        updateStart = timeMicros\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            profile.callsThisUpdate = 0\r\n            profile.microsThisUpdate = 0\r\n            profile.iterationsThisUpdate = 0\r\n        }\r\n    }\r\n    export function endUpdate(timeMicros: number) {\r\n        updates++\r\n        const elapsedMicros = timeMicros - updateStart\r\n\r\n        let duration = elapsedMicros\r\n        if (duration < 0) {\r\n            duration += microsRollOver\r\n        }\r\n\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            profile.totalUpdates++\r\n\r\n            const calls = profile.callsThisUpdate\r\n            profile.totalCalls += calls\r\n            if (calls < profile.minCalls) {\r\n                profile.minCalls = calls\r\n            }\r\n            if (calls > profile.maxCalls) {\r\n                profile.maxCalls = calls\r\n            }\r\n\r\n            const micros = profile.microsThisUpdate\r\n            profile.totalMicros += micros\r\n            if (micros < profile.minMicrosPerUpdate) {\r\n                profile.minMicrosPerUpdate = micros\r\n            }\r\n            if (micros > profile.maxMicrosPerUpdate) {\r\n                profile.maxMicrosPerUpdate = micros\r\n            }\r\n\r\n            const iterations = profile.iterationsThisUpdate\r\n            profile.totalIterations += iterations\r\n            if (iterations < profile.minIterationsPerUpdate) {\r\n                profile.minIterationsPerUpdate = iterations\r\n            }\r\n            if (iterations > profile.maxIterationsPerUpdate) {\r\n                profile.maxIterationsPerUpdate = iterations\r\n            }\r\n        }\r\n    }\r\n\r\n    export function isTimeToReport(timeMillis: number): boolean {\r\n        return timeMillis - lastReport >= 1000\r\n    }\r\n}\r\n","advMath.ts":"interface Vector2 {\n    x: number,\n    y: number\n}\n\n\nnamespace Vector2 {\n\n    export let crossSign: Sign = 1\n\n    interface Readonly {\n        readonly x: number\n        readonly y: number\n    }\n    export const right: Readonly = { x: 1, y: 0 }\n    export const left: Readonly = { x: -1, y: 0 }\n    export const down: Readonly = { x: 0, y: 1 }\n    export const up: Readonly = { x: 0, y: -1 }\n    export const rightDown: Readonly = { x: 1, y: 1 }\n    export const rightUp: Readonly = { x: 1, y: -1 }\n    export const leftDown: Readonly = { x: -1, y: 1 }\n    export const leftUp: Readonly = { x: -1, y: -1 }\n    export const zero: Readonly = { x: 0, y: 0 }\n\n    export function create(x = 0, y = 0): Vector2 {\n        return { x, y }\n    }\n\n    export function clone(v: Vector2): Vector2 {\n        return { x: v.x, y: v.y }\n    }\n\n    export function equals(a: Vector2, b: Vector2): boolean {\n        return a.x === b.x && a.y === b.y\n    }\n\n    export function equalsApprox(\n        a: Vector2,\n        b: Vector2,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(a.x - b.x) <= tolerance &&\n            Math.abs(a.y - b.y) <= tolerance\n        )\n    }\n\n    export function equalsApproxRaw(\n        x1: number,\n        y1: number,\n        x2: number,\n        y2: number,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(x1 - x2) <= tolerance &&\n            Math.abs(y1 - y2) <= tolerance\n        )\n    }\n\n    export function multiply(v: Vector2, by: number): Vector2 {\n        return {\n            x: v.x * by,\n            y: v.y * by\n        }\n    }\n\n    export function add(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x + b.x,\n            y: a.y + b.y\n        }\n    }\n    export function subtract(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x - b.x,\n            y: a.y - b.y\n        }\n    }\n\n    export function magnitude(v: Vector2): number {\n        return magnitudeRaw(v.x, v.y)\n    }\n    export function magnitudeRaw(x: number, y: number): number {\n        return Math.sqrt(x ** 2 + y ** 2)\n    }\n\n    function magnitudeSquared(a: Vector2, b: Vector2): number {\n        const dx = a.x - b.x\n        const dy = a.y - b.y\n        return dx * dx + dy * dy\n    }\n\n    export function cross(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return crossRaw(a.x, a.y, b.x, b.y)\n    }\n    export function crossRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return crossSign * (ax * by - ay * bx)\n    }\n\n    export function dot(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return dotRaw(a.x, a.y, b.x, b.y)\n    }\n    export function dotRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return ax * bx + ay * by\n    }\n\n    export function sign(v: Vector2): Vector2 {\n        return { x: Math.sign(v.x), y: Math.sign(v.y) }\n    }\n\n    export function normalized(v: Vector2): Vector2 {\n        const mag = magnitude(v)\n        if (mag === 0) return { x: 0, y: 0 }\n        return { x: v.x / mag, y: v.y / mag }\n    }\n    export function normalizedRaw(x: number, y: number): [number, number] {\n        const magnitude = magnitudeRaw(x, y)\n        if (magnitude === 0) return [0, 0]\n        return [x / magnitude, y / magnitude]\n    }\n\n    export function normalizedSum(normals: Vector2[]): Vector2 {\n        let combined = {\n            x: 0,\n            y: 0\n        }\n\n        for (const normal of normals) {\n            combined.x += normal.x\n            combined.y += normal.y\n        }\n\n        return Vector2.normalized(combined)\n    }\n    export function applyNormalize(v: Vector2): void {\n        const mag = magnitude(v)\n        if (mag === 0) {\n            v.x = 0\n            v.y = 0\n        } else {\n            v.x /= mag\n            v.y /= mag\n        }\n    }\n    export function reversed(v: Vector2): Vector2 {\n        return { x: v.x * -1, y: v.y * -1 }\n    }\n\n    export function toStringRaw(x: number, y: number): string {\n        return `${x},${y}`\n    }\n    export function toString(v: Vector2): string {\n        return toStringRaw(v.x, v.y)\n    }\n\n    export function toLog(v: Vector2): string {\n        return `(${v.x}, ${v.y})`\n    }\n    export function toLogs(v: Vector2[]): string {\n        let logs = \"\"\n        for (const vertex of v) {\n            logs = logs.concat(`${toLog(vertex)} `)\n        }\n        return logs\n    }\n    export type Direction =\n        | \"right\" | \"left\" | \"up\"\n        | \"down\" | \"rightUp\" | \"leftUp\"\n        | \"rightDown\" | \"leftDown\"\n        ;\n    export function toDirectionString(v: Vector2): Direction {\n        const x = Math.sign(v.x), y = Math.sign(v.y)\n        if (x === 0 && y === 0) return \"down\"\n        const hDir = x === 1 ? \"right\" : x === -1 ? \"left\" : \"\"\n        let vDir = y === 1 ? \"down\" : y === -1 ? \"up\" : \"\"\n        if (hDir !== \"\" && vDir !== \"\")\n            vDir = vDir.charAt(0).toUpperCase() + vDir.slice(1)\n        return (hDir + vDir || \"down\") as Direction\n    }\n}\n\ninterface Segment {\n    start: Vector2\n    end: Vector2\n    vector: Vector2\n    length: number\n    lengthSquared: number\n    bounds: AABB\n    sign: number // what is this for?\n}\nnamespace Segment {\n    const EPSILON = 0.001\n\n    // Optimized\n    export function create(\n        start: Vector2,\n        end: Vector2\n    ): Segment {\n\n        const dx = end.x - start.x\n        const dy = end.y - start.y\n\n        const lengthSquared =\n            dx ** 2 +\n            dy ** 2\n\n        return {\n            start,\n            end,\n\n            vector: {\n                x: dx,\n                y: dy\n            },\n\n            length: Math.sqrt(lengthSquared),\n\n            lengthSquared,\n\n            bounds: {\n                min: Vector2.create(Math.min(start.x, end.x), Math.min(start.y, end.y)),\n                max: Vector2.create(Math.max(start.x, end.x), Math.max(start.y, end.y))\n            },\n            sign: Math.sign(dy)\n        }\n    }\n\n    export function pointAt(segment: Segment, along: number): Vector2 {\n        return {\n            x: segment.start.x + segment.vector.x * along,\n            y: segment.start.y + segment.vector.y * along\n        }\n    }\n\n    export function getAlong(\n        segment: Segment,\n        point: Vector2\n    ): number {\n        const dx = point.x - segment.start.x\n        const dy = point.y - segment.start.y\n\n        return (\n            dx * segment.vector.x +\n            dy * segment.vector.y\n        ) / segment.lengthSquared\n    }\n\n    // consider rename\n    export function containsPoint(\n        point: Vector2,\n        edge: Segment\n    ): boolean {\n\n        const along =\n            getAlong(edge, point)\n\n        if (\n            along < -EPSILON ||\n            along > 1 + EPSILON\n        ) {\n            return false\n        }\n\n        const projected =\n            pointAt(\n                edge,\n                along\n            )\n\n        return (\n            Math.abs(\n                projected.x - point.x\n            ) <= EPSILON &&\n            Math.abs(\n                projected.y - point.y\n            ) <= EPSILON\n        )\n    }\n    // Optimized: Could be in a segment math namespace\n    export function getRayIntersection(\n        rayStart: Vector2,\n        rayDirection: Vector2,\n        segment: Segment\n    ): number | undefined {\n\n        const toSegmentX = segment.start.x - rayStart.x\n        const toSegmentY = segment.start.y - rayStart.y\n\n        const cross =\n            rayDirection.x * segment.vector.y -\n            rayDirection.y * segment.vector.x\n\n        if (Math.abs(cross) <= EPSILON) {\n            return undefined\n        }\n\n        const t =\n            (\n                toSegmentX * segment.vector.y -\n                toSegmentY * segment.vector.x\n            ) / cross\n\n        if (t < 0) {\n            return undefined\n        }\n\n        const u =\n            (\n                toSegmentX * rayDirection.y -\n                toSegmentY * rayDirection.x\n            ) / cross\n\n        if (u < 0 || u > 1) {\n            return undefined\n        }\n\n        return t\n    }\n\n    export enum Side {\n        Left,\n        Right\n    }\n\n    // Optimized\n    export function getNormal(\n        segment: Segment,\n        side: Side\n    ): Vector2 {\n        const sign = side === Side.Left ? 1 : -1\n\n        return {\n            x: segment.vector.y * sign / segment.length,\n            y: -segment.vector.x * sign / segment.length\n        }\n    }\n\n    // Optimized: Could be it's own segment Math\n    export function getNormals(\n        segments: Segment[],\n        side: Side\n    ): Vector2[] {\n\n        const normals: Vector2[] = []\n\n        for (const segment of segments) {\n            normals.push(getNormal(segment, side))\n        }\n        return normals\n    }\n\n    export function toLog(segment: Segment): string {\n        const vertices = `Vertices: ${Vector2.toLog(segment.start)} -> ${Vector2.toLog(segment.end)}`\n        const vector = ` | Vector: ${Vector2.toLog(segment.vector)}`\n        const length = ` | length: ${segment.length}, lengthSquared: ${segment.lengthSquared}`\n        const sign = ` | Sign: ${segment.sign}`\n        const bounds = \" | Bounds; \" + AABB.toLog(segment.bounds)\n        return vertices + vector + length + bounds\n    }\n}\n\ninterface Edge extends Segment {\n    index: number\n    startIndex: number\n    endIndex: number\n    normal: Vector2\n}\nnamespace Edge {\n\n    enum Winding {\n        Clockwise,\n        CounterClockwise\n    }\n    export function getWinding(edges: Edge[]): Winding {\n\n        let area = 0\n\n        for (const edge of edges) {\n            area +=\n                edge.start.x * edge.end.y -\n                edge.end.x * edge.start.y\n        }\n\n        return area < 0\n            ? Winding.Clockwise\n            : Winding.CounterClockwise\n    }\n\n    export function create(\n        start: Vector2,\n        end: Vector2,\n        startIndex: number,\n        endIndex: number,\n        index: number,\n        winding: Winding = Winding.Clockwise\n    ): Edge {\n        const segment = Segment.create(start, end)\n        //console.log(getSegmentNormal(segment, Side.Left))\n        return {\n            start: segment.start,\n            end: segment.end,\n            vector: segment.vector,\n            length: segment.length,\n            lengthSquared: segment.lengthSquared,\n            bounds: segment.bounds,\n            sign: segment.sign,\n            index,\n            startIndex,\n            endIndex,\n            normal: Segment.getNormal(\n                segment,\n                winding === Winding.Clockwise\n                    ? Segment.Side.Left\n                    : Segment.Side.Right\n            )\n        }\n    }\n\n    export function clone(edge: Edge, start: Vector2, end: Vector2): Edge {\n        //const start = startRef === undefined ? Vector2.clone(edge.start) : startRef\n        //const end = endRef === undefined ? Vector2.clone(edge.end) : endRef\n        //const vector = {x: end.x - start.x,y: end.y - start.y}\n\n        const newEdge = {\n            start,\n            end,\n            vector: Vector2.clone(edge.vector),\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: AABB.clone(edge.bounds),\n            sign: edge.sign,\n            index: edge.index,\n            startIndex: edge.startIndex,\n            endIndex: edge.endIndex,\n            normal: Vector2.clone(edge.normal)\n        }\n        return newEdge\n    }\n\n    export function createFromVertices(\n        vertices: Vector2[]\n    ): Edge[] {\n\n        const edges: Edge[] = []\n\n        for (let i = 0; i < vertices.length; i++) {\n            const startIndex = i\n            const endIndex = (i + 1) % vertices.length\n\n            edges.push(\n                create(\n                    vertices[startIndex],\n                    vertices[endIndex],\n                    startIndex,\n                    endIndex,\n                    startIndex\n                )\n            )\n        }\n\n        return edges\n    }\n    export function reverse(edge: Edge): Edge {\n        return {\n            index: edge.index,\n            start: edge.end,\n            end: edge.start,\n\n            vector: {\n                x: -edge.vector.x,\n                y: -edge.vector.y\n            },\n\n            startIndex: edge.endIndex,\n            endIndex: edge.startIndex,\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: edge.bounds,\n            sign: -edge.sign,\n\n            normal: {\n                x: -edge.normal.x,\n                y: -edge.normal.y\n            }\n        }\n    }\n    export function toLog(edge: Edge): string {\n        const segmentInfo = Segment.toLog(edge)\n\n        const index = ` | StartIndex: ${edge.startIndex}, EndIndex: ${edge.endIndex}`\n        const normal = ` | Normal: ${Vector2.toLog(edge.normal)}`\n        return segmentInfo + index + normal\n    }\n    export function toLogs(edges: Edge[]): string {\n        let logs = \"\"\n        for (const edge of edges) {\n            logs = logs.concat(toLog(edge))\n        }\n\n        return logs\n    }\n}\ntype PointGroup = {\n    direction: Vector2\n    points: Vector2[]\n}\n\ntype PolyBounds = AABB & {\n    boundPoints: PointGroup[]\n}\ninterface Polygon {\n    vertices: Vector2[]\n    origin: Vector2\n    edges: Edge[]\n    bounds: PolyBounds\n}\nnamespace Polygon {\n\n    // POLYGON CREATION \n\n    /**\n     * Creates a regular convex polygon centered at the origin.\n     * Vertices are evenly distributed around the given radius.\n     * Defaults to an upward-facing orientation.\n     */\n    const UP_ANGLE: number = -Math.PI / 2\n    export function create(\n        sides: number,\n        radius: number,\n        rotation?: number,\n        origin: Vector2 = null\n    ): Polygon {\n        if (rotation === undefined) {\n            rotation = UP_ANGLE\n        }\n\n        const verticies: Vector2[] = []\n\n        const angleStep = (Math.PI * 2) / sides\n\n        for (let i = 0; i < sides; i++) {\n            const angle = rotation + i * angleStep\n\n            verticies.push({\n                x: Math.cos(angle) * radius,\n                y: Math.sin(angle) * radius\n            })\n        }\n\n        return createFromVertices(verticies, origin)\n    }\n\n    /**\n     * Creates a polygon from an array of vertices.\n     * Vertices are connected in the order provided,\n     * regardless of their positions.\n     *\n     * Winding direction is determined by vertex order.\n     * Can create concave or self-intersecting polygons.\n     */\n    export function createFromVertices(vertices: Vector2[], origin: Vector2 = null): Polygon {\n        const edges = Edge.createFromVertices(vertices)\n        const bounds = getBounds(vertices)\n        if (!origin) origin = { x: 0, y: 0 }\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function clone(polygon: Polygon): Polygon {\n        let vertices: Vector2[] = []\n        for (let v = 0; v < polygon.vertices.length; v++) {\n            const vertex = polygon.vertices[v]\n            vertices[v] = { x: vertex.x, y: vertex.y }\n        }\n        let edges: Edge[] = []\n        for (let e = 0; e < polygon.edges.length; e++) {\n            const edge = polygon.edges[e]\n            edges.push(Edge.clone(edge, vertices[edge.startIndex], vertices[edge.endIndex]))\n        }\n\n        const bounds = getBounds(vertices)\n        const origin = Vector2.clone(polygon.origin)\n\n        //return polygon\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function createTriangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: 0, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createRectangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w, y: -h },\n            { x: w, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createOctagon(\n        width: number = 16,\n        height: number = 16,\n        cut: number = 3,\n        origin: Vector2 = null\n    ): Polygon {\n\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w + cut, y: -h },\n            { x: w - cut, y: -h },\n            { x: w, y: -h + cut },\n            { x: w, y: h - cut },\n            { x: w - cut, y: h },\n            { x: -w + cut, y: h },\n            { x: -w, y: h - cut },\n            { x: -w, y: -h + cut }\n        ], origin)\n    }\n\n    // POLYGON BOUNDS \n\n\n\n    export function getBounds(vertices: Vector2[]): PolyBounds {\n        let minX = vertices[0].x\n        let maxX = vertices[0].x\n        let minY = vertices[0].y\n        let maxY = vertices[0].y\n\n        let minXPoints = [vertices[0]]\n        let maxXPoints = [vertices[0]]\n        let minYPoints = [vertices[0]]\n        let maxYPoints = [vertices[0]]\n\n        for (let i = 1; i < vertices.length; i++) {\n            const point = vertices[i]\n\n            if (point.x < minX) {\n                minX = point.x\n                minXPoints = [point]\n            } else if (point.x == minX) {\n                minXPoints.push(point)\n            }\n\n            if (point.x > maxX) {\n                maxX = point.x\n                maxXPoints = [point]\n            } else if (point.x == maxX) {\n                maxXPoints.push(point)\n            }\n\n            if (point.y < minY) {\n                minY = point.y\n                minYPoints = [point]\n            } else if (point.y == minY) {\n                minYPoints.push(point)\n            }\n\n            if (point.y > maxY) {\n                maxY = point.y\n                maxYPoints = [point]\n            } else if (point.y == maxY) {\n                maxYPoints.push(point)\n            }\n        }\n\n        return {\n            minX,\n            maxX,\n            minY,\n            maxY,\n\n            boundPoints: [\n                {\n                    direction: { x: -1, y: 0 },\n                    points: minXPoints\n                },\n                {\n                    direction: { x: 1, y: 0 },\n                    points: maxXPoints\n                },\n                {\n                    direction: { x: 0, y: -1 },\n                    points: minYPoints\n                },\n                {\n                    direction: { x: 0, y: 1 },\n                    points: maxYPoints\n                }\n            ]\n        }\n    }\n\n    // POLYGON OPERATIONS\n\n    export function getWidth(vertices: Vector2[]): number {\n        let minX = Infinity\n        let maxX = -Infinity\n\n        for (const vertex of vertices) {\n            minX = Math.min(minX, vertex.x)\n            maxX = Math.max(maxX, vertex.x)\n        }\n\n        return maxX - minX\n    }\n\n    export function getHeight(vertices: Vector2[]): number {\n        let minY = Infinity\n        let maxY = -Infinity\n\n        for (const vertex of vertices) {\n            minY = Math.min(minY, vertex.y)\n            maxY = Math.max(maxY, vertex.y)\n        }\n\n        return maxY - minY\n    }\n\n    export function getArea(vertices: Vector2[]): number {\n        let area = 0\n\n        for (let i = 0; i < vertices.length; i++) {\n            const a = vertices[i]\n            const b = vertices[\n                (i + 1) % vertices.length\n            ]\n\n            area +=\n                a.x * b.y -\n                b.x * a.y\n        }\n\n        return Math.abs(area) * 0.5\n    }\n\n    export function getDepth(\n        verticesA: Vector2[],\n        verticesB: Vector2[],\n        direction: Vector2\n    ): number {\n        let minA =\n            Vector2.dot(\n                verticesA[0],\n                direction\n            )\n\n        let maxB =\n            Vector2.dot(\n                verticesB[0],\n                direction\n            )\n\n        for (let i = 1; i < verticesA.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesA[i],\n                    direction\n                )\n\n            if (projection < minA) {\n                minA = projection\n            }\n        }\n\n        for (let i = 1; i < verticesB.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesB[i],\n                    direction\n                )\n\n            if (projection > maxB) {\n                maxB = projection\n            }\n        }\n\n\n        return Math.abs(maxB - minA)\n    }\n\n    // TRANSLATE OPERATIONS\n\n    /**\n     * translates/mutates a polygon to a position\n     */\n    export function translateTo(polygon: Polygon, position: Vector2) {\n        const delta = Vector2.subtract(position, polygon.origin)\n        translate(polygon, delta)\n    }\n\n    /**\n     * translates/mutates a polygon by a delta\n     */\n    export function translate(polygon: Polygon, delta: Vector2) {\n        polygon.origin.x += delta.x\n        polygon.origin.y += delta.y\n\n        for (let vertex of polygon.vertices) {\n            vertex.x += delta.x\n            vertex.y += delta.y\n        }\n\n        for (let edge of polygon.edges) {\n            edge.bounds.minX += delta.x\n            edge.bounds.maxX += delta.x\n            edge.bounds.minY += delta.y\n            edge.bounds.maxY += delta.y\n        }\n\n        const bounds = polygon.bounds\n\n        bounds.minX += delta.x\n        bounds.maxX += delta.x\n        bounds.minY += delta.y\n        bounds.maxY += delta.y\n    }\n\n    /**\n     * Returns a new polygon translated by a delta\n     */\n    export function translated(polygon: Polygon, delta: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translate(newPolygon, delta)\n        return newPolygon\n    }\n    /**\n     * Returns a new polygon translated to a position\n     */\n    export function translatedTo(polygon: Polygon, position: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translateTo(newPolygon, position)\n        return newPolygon\n    }\n\n    // LOG OPERATIONS\n\n    export function logBounds(shapeName: string, thisBounds: PolyBounds) {\n        console.log(\n            \"BoundingBox \" + shapeName + \": (\" +\n            thisBounds.minX + \", \" +\n            thisBounds.minY + \") -> (\" +\n            thisBounds.maxX + \", \" +\n            thisBounds.maxY + \")\"\n        )\n        console.log(\n            \" BoundPoints \" + shapeName + \": \"\n        )\n        for (let i = 0; i < thisBounds.boundPoints.length; i++) {\n            let data = \"\"\n            for (let j = 0; j < thisBounds.boundPoints[i].points.length; j++) {\n                const bound = thisBounds.boundPoints[i]\n                data = data.concat(\n                    \" point \" + j + \": \" + Vector2.toString(bound.points[j])\n                )\n            }\n            console.log(i + \": \" + data)\n        }\n    }\n\n    export function toLog(polygon: Polygon): string {\n        const vertices = \" Vertices: \" + Vector2.toLogs(polygon.vertices)\n        const origin = \" | origin: \" + Vector2.toLog(polygon.origin)\n        const edges = \" | Edges: \" + Edge.toLogs(polygon.edges)\n        const bounds = \" | Bounds: \" + Bounds.toLog(polygon.bounds)\n        return vertices + origin + edges + bounds\n    }\n}\ninterface AABB {\n    min: Vector2\n    max: Vector2\n}\nnamespace AABB {\n    export function clone(bounds: AABB): AABB {\n        return {\n            min: { x: bounds.min.x, y: bounds.min.y},\n            max: { x: bounds.max.x, y: bounds.max.y}\n        }\n    }\n    export function toLog(bounds: AABB): string {\n        return `min: ${Vector2.toLog(bounds.min)}, max: ${Vector2.toLog(bounds.max)}`\n    }\n}\ninterface Circle {\n    center: Vector2\n    radius: number\n}\nnamespace Circle {\n    export function create(center: Vector2, radius: number): Circle {\n        return {\n            center,\n            radius\n        }\n    }\n\n    export function containsPoint(circle: Circle, point: Vector2): boolean {\n        const dx = point.x - circle.center.x\n        const dy = point.y - circle.center.y\n\n        return dx ** 2 + dy ** 2 <= circle.radius ** 2\n    }\n\n    export function intersects(a: Circle, b: Circle): boolean {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n        const radius = a.radius + b.radius\n\n        return dx ** 2 + dy ** 2 <= radius ** 2\n    }\n\n    export function getMidpoint(a: Circle, b: Circle): Vector2 | null {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distanceSquared = dx ** 2 + dy ** 2\n        const radius = a.radius + b.radius\n        if (distanceSquared > radius ** 2) {\n            return null\n        }\n\n        return {\n            x: (a.center.x + b.center.x) / 2,\n            y: (a.center.y + b.center.y) / 2\n        }\n    }\n\n    export function getPenetration(a: Circle, b: Circle): number {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx * dx + dy * dy)\n\n        return Math.max(0, a.radius + b.radius - distance)\n    }\n    function getPoints(radius: number): Vector2[] {\n        const points: Vector2[] = []\n\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            points.push({\n                x: Math.cos(radians) * radius,\n                y: Math.sin(radians) * radius\n            })\n        }\n\n        return points\n    }\n    export function getNormal(\n        a: Circle,\n        b: Circle\n    ): Vector2 {\n\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx ** 2 + dy ** 2)\n        if (distance === 0) {\n            return { x: 1, y: 0 }\n        }\n\n        return {\n            x: dx / distance,\n            y: dy / distance\n        }\n    }\n\n    export function getBounds(circle: Circle): AABB {\n        return {\n            min: {\n                x: circle.center.x - circle.radius,\n                y: circle.center.y - circle.radius\n            },\n            max: {\n                x: circle.center.x + circle.radius,\n                y: circle.center.y + circle.radius\n            }\n        }\n    }\n}\n\n","test.ts":"// Add your code here\nlet circles: Circle[] = []\nlet circleVs: Vector2[] = []\nlet rendered = 0\nfunction MakeCircle() {\n    let circle = Circle.create({ x: 1, y: 1 }, 2)\n    circles.push(circle)\n    circleVs.push(Vector2.create(20, 0))\n\n    scene.createRenderable(0, () => {\n        screen.setPixel(circle.center.x, circle.center.y, 1)\n    })\n    if (rendered >= 0) return\n    rendered++\n    scene.createRenderable(0, () => {\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            const x = circle.center.x + circle.radius * Math.cos(radians)\n            const y = circle.center.y + circle.radius * Math.sin(radians)\n\n            screen.setPixel(Math.floor(x), Math.floor(y), 1)\n        }\n    })\n}\n\n\n\nfunction CircleTest() {\n    game.stats = true\n    let count = 0\n    const display = sprites.create(img`\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n    `)\n    display.x = 100\n    display.y = 40\n    game.onUpdateInterval(500, function () {\n        MakeCircle()\n        count++\n        display.sayText(count.toString())\n    })\n\n    const gravity = 300\n\n    game.onUpdate(function () {\n        const dt = control.eventContext().deltaTime\n\n        for (let i = 0; i < circles.length; i++) {\n\n            const circle = circles[i]\n            const velocity = circleVs[i]\n\n            velocity.y += gravity * dt\n\n            const position = circle.center\n\n            position.x += velocity.x * dt\n            position.y += velocity.y * dt\n\n\n        }\n    })\n    const iterations = 6\n    game.onUpdate(function () {\n        for (let iteration = 0; iteration < iterations; iteration++) {\n            for (let i = 0; i < circles.length; i++) {\n                const circle = circles[i]\n                const velocity = circleVs[i]\n                const position = circle.center\n\n                // Screen boundaries\n                if (position.x < circle.radius) {\n                    position.x = circle.radius\n                    if (velocity.x < 0) velocity.x *= -0.5\n                }\n                else if (position.x > 160 - circle.radius) {\n                    position.x = 160 - circle.radius\n                    if (velocity.x > 0) velocity.x *= -0.5\n                }\n\n                if (position.y < circle.radius) {\n                    position.y = circle.radius\n                    if (velocity.y < 0) velocity.y *= -0.5\n                }\n                else if (position.y > 120 - circle.radius) {\n                    position.y = 120 - circle.radius\n                    if (velocity.y > 0) velocity.y *= -0.5\n                }\n\n                // Circle collisions\n                for (let j = i + 1; j < circles.length; j++) {\n                    const otherCircle = circles[j]\n                    const otherVelocity = circleVs[j]\n\n                    const pen = Circle.getPenetration(circle, otherCircle)\n                    if (pen <= 0) continue\n\n                    const dir = Circle.getNormal(circle, otherCircle)\n                    const correction = pen * 0.5\n\n                    circle.center.x -= dir.x * correction\n                    circle.center.y -= dir.y * correction\n                    otherCircle.center.x += dir.x * correction\n                    otherCircle.center.y += dir.y * correction\n\n                    // Velocity response\n                    const rvx = otherVelocity.x - velocity.x\n                    const rvy = otherVelocity.y - velocity.y\n                    const alongNormal = rvx * dir.x + rvy * dir.y\n\n                    if (alongNormal < 0) {\n                        const impulse = -(1 + 0.5) * alongNormal * 0.5\n\n                        velocity.x -= impulse * dir.x\n                        velocity.y -= impulse * dir.y\n\n                        otherVelocity.x += impulse * dir.x\n                        otherVelocity.y += impulse * dir.y\n                    }\n                }\n            }\n        }\n    })\n}\n\nCircleTest()","pxt.json":"{\n    \"name\": \"TSKit\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"core.ts\",\n        \"advMath.ts\",\n        \"test.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794522014421,"editorVersion":"4.1.27","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block></xml>","main.ts":"\n","README.md":" ","assets.json":"","core.ts":"\r\n// TYPES\r\ntype Key = number | string\r\ntype Identity = Key | object\r\ntype Primitive = number | string | boolean | null\r\ntype Sign = 1 | -1\r\n\r\ninterface Dictionary<T> {\r\n    [key: string]: T\r\n}\r\ninterface ManagedReference<T> {\r\n    value: T | undefined\r\n}\r\ninterface ValidityProvider<T> {\r\n    isValid(object: T): boolean\r\n}\r\ninterface CoordinateConfig {\r\n    originX: number\r\n    originY: number\r\n    axisX: Sign\r\n    axisY: Sign\r\n}\r\nnamespace Object {\r\n\r\n    /**\r\n     * EXPERIMENTAL\r\n     *\r\n     * Returns a deep clone of a value.\r\n     * Recursively clones arrays and objects, including their nested values.\r\n     *\r\n     * Does not preserve shared references or support circular references.\r\n     */\r\n    export function deepClone<T>(value: T): T {\r\n        const originals: any[] = []\r\n        const clones: any[] = []\r\n\r\n        return <T><any>cloneRecursive(value, originals, clones)\r\n    }\r\n\r\n    function cloneRecursive(\r\n        value: any,\r\n        originals: any[],\r\n        clones: any[]\r\n    ): any {\r\n        if (value === null || typeof value !== \"object\") {\r\n            return value\r\n        }\r\n\r\n        // Return an existing clone if this object was already visited.\r\n        for (let i = 0; i < originals.length; i++) {\r\n            if (originals[i] === value) {\r\n                return clones[i]\r\n            }\r\n        }\r\n\r\n        let result: any\r\n\r\n        if (Array.isArray(value)) {\r\n            result = []\r\n        } else {\r\n            result = {}\r\n        }\r\n\r\n        // Register before cloning children to handle circular references.\r\n        originals.push(value)\r\n        clones.push(result)\r\n\r\n        if (Array.isArray(value)) {\r\n            for (let i = 0; i < value.length; i++) {\r\n                result.push(cloneRecursive(value[i], originals, clones))\r\n            }\r\n        } else {\r\n            const keys = Object.keys(value)\r\n\r\n            for (let i = 0; i < keys.length; i++) {\r\n                const key = keys[i]\r\n                result[key] = cloneRecursive(value[key], originals, clones)\r\n            }\r\n        }\r\n\r\n        return result\r\n    }\r\n}\r\n\r\nnamespace Identity {\r\n\r\n    export const uidTag = \"__UID\"\r\n    export type UID = number & {\r\n        _brand: \"IdentityID\"\r\n    }\r\n\r\n    interface Entry { __UID?: UID | null }\r\n\r\n    let nextUID = 0\r\n    function generateUID(): UID {\r\n        return nextUID++ as UID\r\n    }\r\n\r\n    let entries: Dictionary<object | Primitive> = {}\r\n\r\n    function isObject(value: any): boolean {\r\n        return value !== undefined && value !== null && typeof value === \"object\"\r\n    }\r\n\r\n    function isValid(key: Key | null | undefined): boolean {\r\n        return key !== undefined && key !== null\r\n    }\r\n\r\n    function isRegistered(id: UID): boolean {\r\n        return entries[id] !== undefined\r\n    }\r\n\r\n    function isObjectRegistered(obj: object): boolean {\r\n        const entry = obj as object & Entry\r\n        const uid = entry[uidTag]\r\n\r\n        return isValid(uid) && entries[uid] === obj\r\n    }\r\n\r\n    export function register(value: any): UID {\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            const uid = obj[uidTag]\r\n\r\n            if (isValid(uid) && entries[uid] === obj) {\r\n                return uid\r\n            }\r\n\r\n            obj[uidTag] = generateUID()\r\n\r\n            entries[obj[uidTag]] = obj\r\n            return obj[uidTag]\r\n        }\r\n        const uid = generateUID()\r\n        entries[uid] = value\r\n        return uid\r\n    }\r\n\r\n    export function unregister(id: UID) {\r\n        if (!isRegistered(id)) {\r\n            return\r\n        }\r\n\r\n        const value = entries[id]\r\n        if (isObject(value)) {\r\n            const obj = value as object & Entry\r\n            if (obj[uidTag] === id) {\r\n                obj[uidTag] = null\r\n            }\r\n        }\r\n\r\n        delete entries[id]\r\n    }\r\n\r\n    export function getID(obj: object): UID | undefined | null {\r\n        return (obj as Entry)[uidTag]\r\n    }\r\n\r\n    export function getValue(id: Identity): any {\r\n        if (isObject(id)) {\r\n            const objectID = (id as Entry)[uidTag]\r\n\r\n            if (!isValid(objectID)) return undefined\r\n            return entries[objectID]\r\n        }\r\n        const key = id as Key\r\n        return entries[key]\r\n    }\r\n}\r\nnamespace Time {\r\n    export let Log = false\r\n    export let deltaMillis = 0\r\n    export let delta = 0\r\n    export let updates = 0\r\n    export let updateStart = 0\r\n    export let lastReport = updates\r\n\r\n    // Microseconds\r\n    export let microsBits = 30\r\n    export let microsMax = 2 ** microsBits - 1\r\n    export let microsRollOver = microsMax + 1\r\n\r\n    export interface Profile {\r\n        name: string\r\n\r\n        // per call \r\n        start: number\r\n        minMicrosPerCall: number\r\n        maxMicrosPerCall: number\r\n\r\n        // this update\r\n        callsThisUpdate: number\r\n        microsThisUpdate: number\r\n        iterationsThisUpdate: number\r\n\r\n        // per update\r\n        minCalls: number\r\n        maxCalls: number\r\n        minMicrosPerUpdate: number\r\n        maxMicrosPerUpdate: number\r\n        minIterationsPerUpdate: number\r\n        maxIterationsPerUpdate: number\r\n\r\n        // totals\r\n        totalUpdates: number\r\n        totalCalls: number\r\n        totalMicros: number\r\n        totalIterations: number\r\n    }\r\n\r\n    export let profiles: Dictionary<Profile> = {}\r\n    export function createProfile(name: string): Profile {\r\n        return {\r\n            name: name,\r\n            start: 0,\r\n            callsThisUpdate: 0,\r\n            microsThisUpdate: 0,\r\n            iterationsThisUpdate: 0,\r\n\r\n            minMicrosPerCall: Infinity,\r\n            maxMicrosPerCall: 0,\r\n\r\n            totalUpdates: 0,\r\n            totalCalls: 0,\r\n            totalMicros: 0,\r\n            totalIterations: 0,\r\n\r\n            minCalls: Infinity,\r\n            maxCalls: 0,\r\n            minMicrosPerUpdate: Infinity,\r\n            maxMicrosPerUpdate: 0,\r\n            minIterationsPerUpdate: Infinity,\r\n            maxIterationsPerUpdate: 0,\r\n        }\r\n    }\r\n    export function getProfile(name: string): Profile {\r\n\r\n        if (profiles[name]) return profiles[name]\r\n\r\n        const profile: Profile = createProfile(name)\r\n\r\n        profiles[name] = profile\r\n        return profile\r\n    }\r\n\r\n    export function countIterations(name: string, count: number) {\r\n        getProfile(name).iterationsThisUpdate += count\r\n    }\r\n\r\n    export function resetProfile() {\r\n        profiles = {}\r\n    }\r\n    export function update(deltaMillisP: number, deltaP: number) {\r\n        deltaMillis = deltaMillisP\r\n        delta = deltaP\r\n    }\r\n    export function reportProfiles(timeMillis: number): string | undefined {\r\n        if (!Log) return undefined\r\n        let logs = \"\"\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            const profileName = profile.name\r\n            const perCall = \" === Per Call\" +\r\n                \" | Avg ms: \" + profile.totalMicros / profile.totalCalls / 1000 +\r\n                \" | Min ms: \" + profile.minMicrosPerCall / 1000 +\r\n                \" | Max ms: \" + profile.maxMicrosPerCall / 1000\r\n            const perUpdate = \" === Per Update\" +\r\n                \" | Avg Calls: \" + profile.totalCalls / profile.totalUpdates +\r\n                \" | Min Calls: \" + profile.minCalls +\r\n                \" | Max Calls: \" + profile.maxCalls +\r\n                \" | Avg ms: \" + profile.totalMicros / profile.totalUpdates / 1000 +\r\n                \" | Min ms: \" + profile.minMicrosPerUpdate / 1000 +\r\n                \" | Max ms: \" + profile.maxMicrosPerUpdate / 1000\r\n            const log = `\r\n            ${profileName} \r\n            ${perCall} \r\n            ${perUpdate}`\r\n            logs = logs.concat(log)\r\n        }\r\n        lastReport = timeMillis\r\n        return logs\r\n    }\r\n\r\n    export function startProfile(name: string, timeMicros: number) {\r\n        let profile = getProfile(name)\r\n        profile.callsThisUpdate++\r\n        profile.start = timeMicros\r\n    }\r\n\r\n    export function endProfile(name: string, timeMicros: number) {\r\n        let profile = getProfile(name)\r\n        let elapsedMicros = timeMicros - profile.start\r\n\r\n        // Handle timer wrapping around\r\n        if (elapsedMicros < 0) {\r\n            elapsedMicros += microsRollOver\r\n        }\r\n        if (elapsedMicros < profile.minMicrosPerCall || profile.minMicrosPerCall == 0) {\r\n            profile.minMicrosPerCall = elapsedMicros\r\n        }\r\n        if (elapsedMicros > profile.maxMicrosPerCall) {\r\n            profile.maxMicrosPerCall = elapsedMicros\r\n        }\r\n        profile.microsThisUpdate += elapsedMicros\r\n        profile.start = 0\r\n    }\r\n\r\n    export function beginUpdate(timeMicros: number) {\r\n        updateStart = timeMicros\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            profile.callsThisUpdate = 0\r\n            profile.microsThisUpdate = 0\r\n            profile.iterationsThisUpdate = 0\r\n        }\r\n    }\r\n    export function endUpdate(timeMicros: number) {\r\n        updates++\r\n        const elapsedMicros = timeMicros - updateStart\r\n\r\n        let duration = elapsedMicros\r\n        if (duration < 0) {\r\n            duration += microsRollOver\r\n        }\r\n\r\n        const keys = Object.keys(profiles)\r\n        for (let key of keys) {\r\n            const profile = profiles[key]\r\n            profile.totalUpdates++\r\n\r\n            const calls = profile.callsThisUpdate\r\n            profile.totalCalls += calls\r\n            if (calls < profile.minCalls) {\r\n                profile.minCalls = calls\r\n            }\r\n            if (calls > profile.maxCalls) {\r\n                profile.maxCalls = calls\r\n            }\r\n\r\n            const micros = profile.microsThisUpdate\r\n            profile.totalMicros += micros\r\n            if (micros < profile.minMicrosPerUpdate) {\r\n                profile.minMicrosPerUpdate = micros\r\n            }\r\n            if (micros > profile.maxMicrosPerUpdate) {\r\n                profile.maxMicrosPerUpdate = micros\r\n            }\r\n\r\n            const iterations = profile.iterationsThisUpdate\r\n            profile.totalIterations += iterations\r\n            if (iterations < profile.minIterationsPerUpdate) {\r\n                profile.minIterationsPerUpdate = iterations\r\n            }\r\n            if (iterations > profile.maxIterationsPerUpdate) {\r\n                profile.maxIterationsPerUpdate = iterations\r\n            }\r\n        }\r\n    }\r\n\r\n    export function isTimeToReport(timeMillis: number): boolean {\r\n        return timeMillis - lastReport >= 1000\r\n    }\r\n}\r\n","advMath.ts":"interface Vector2 {\n    x: number,\n    y: number\n}\n\n\nnamespace Vector2 {\n\n    export let crossSign: Sign = 1\n\n    interface Readonly {\n        readonly x: number\n        readonly y: number\n    }\n    export const right: Readonly = { x: 1, y: 0 }\n    export const left: Readonly = { x: -1, y: 0 }\n    export const down: Readonly = { x: 0, y: 1 }\n    export const up: Readonly = { x: 0, y: -1 }\n    export const rightDown: Readonly = { x: 1, y: 1 }\n    export const rightUp: Readonly = { x: 1, y: -1 }\n    export const leftDown: Readonly = { x: -1, y: 1 }\n    export const leftUp: Readonly = { x: -1, y: -1 }\n    export const zero: Readonly = { x: 0, y: 0 }\n\n    export function create(x = 0, y = 0): Vector2 {\n        return { x, y }\n    }\n\n    export function clone(v: Vector2): Vector2 {\n        return { x: v.x, y: v.y }\n    }\n\n    export function equals(a: Vector2, b: Vector2): boolean {\n        return a.x === b.x && a.y === b.y\n    }\n\n    export function equalsApprox(\n        a: Vector2,\n        b: Vector2,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(a.x - b.x) <= tolerance &&\n            Math.abs(a.y - b.y) <= tolerance\n        )\n    }\n\n    export function equalsApproxRaw(\n        x1: number,\n        y1: number,\n        x2: number,\n        y2: number,\n        tolerance: number\n    ): boolean {\n        return (\n            Math.abs(x1 - x2) <= tolerance &&\n            Math.abs(y1 - y2) <= tolerance\n        )\n    }\n\n    export function multiply(v: Vector2, by: number): Vector2 {\n        return {\n            x: v.x * by,\n            y: v.y * by\n        }\n    }\n\n    export function add(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x + b.x,\n            y: a.y + b.y\n        }\n    }\n    export function subtract(a: Vector2, b: Vector2): Vector2 {\n        return {\n            x: a.x - b.x,\n            y: a.y - b.y\n        }\n    }\n\n    export function magnitude(v: Vector2): number {\n        return magnitudeRaw(v.x, v.y)\n    }\n    export function magnitudeRaw(x: number, y: number): number {\n        return Math.sqrt(x ** 2 + y ** 2)\n    }\n\n    function magnitudeSquared(a: Vector2, b: Vector2): number {\n        const dx = a.x - b.x\n        const dy = a.y - b.y\n        return dx * dx + dy * dy\n    }\n\n    export function cross(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return crossRaw(a.x, a.y, b.x, b.y)\n    }\n    export function crossRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return crossSign * (ax * by - ay * bx)\n    }\n\n    export function dot(\n        a: Vector2,\n        b: Vector2\n    ): number {\n        return dotRaw(a.x, a.y, b.x, b.y)\n    }\n    export function dotRaw(\n        ax: number,\n        ay: number,\n        bx: number,\n        by: number\n    ): number {\n        return ax * bx + ay * by\n    }\n\n    export function sign(v: Vector2): Vector2 {\n        return { x: Math.sign(v.x), y: Math.sign(v.y) }\n    }\n\n    export function normalized(v: Vector2): Vector2 {\n        const mag = magnitude(v)\n        if (mag === 0) return { x: 0, y: 0 }\n        return { x: v.x / mag, y: v.y / mag }\n    }\n    export function normalizedRaw(x: number, y: number): [number, number] {\n        const magnitude = magnitudeRaw(x, y)\n        if (magnitude === 0) return [0, 0]\n        return [x / magnitude, y / magnitude]\n    }\n\n    export function normalizedSum(normals: Vector2[]): Vector2 {\n        let combined = {\n            x: 0,\n            y: 0\n        }\n\n        for (const normal of normals) {\n            combined.x += normal.x\n            combined.y += normal.y\n        }\n\n        return Vector2.normalized(combined)\n    }\n    export function applyNormalize(v: Vector2): void {\n        const mag = magnitude(v)\n        if (mag === 0) {\n            v.x = 0\n            v.y = 0\n        } else {\n            v.x /= mag\n            v.y /= mag\n        }\n    }\n    export function reversed(v: Vector2): Vector2 {\n        return { x: v.x * -1, y: v.y * -1 }\n    }\n\n    export function toStringRaw(x: number, y: number): string {\n        return `${x},${y}`\n    }\n    export function toString(v: Vector2): string {\n        return toStringRaw(v.x, v.y)\n    }\n\n    export function toLog(v: Vector2): string {\n        return `(${v.x}, ${v.y})`\n    }\n    export function toLogs(v: Vector2[]): string {\n        let logs = \"\"\n        for (const vertex of v) {\n            logs = logs.concat(`${toLog(vertex)} `)\n        }\n        return logs\n    }\n    export type Direction =\n        | \"right\" | \"left\" | \"up\"\n        | \"down\" | \"rightUp\" | \"leftUp\"\n        | \"rightDown\" | \"leftDown\"\n        ;\n    export function toDirectionString(v: Vector2): Direction {\n        const x = Math.sign(v.x), y = Math.sign(v.y)\n        if (x === 0 && y === 0) return \"down\"\n        const hDir = x === 1 ? \"right\" : x === -1 ? \"left\" : \"\"\n        let vDir = y === 1 ? \"down\" : y === -1 ? \"up\" : \"\"\n        if (hDir !== \"\" && vDir !== \"\")\n            vDir = vDir.charAt(0).toUpperCase() + vDir.slice(1)\n        return (hDir + vDir || \"down\") as Direction\n    }\n}\n\ninterface Segment {\n    start: Vector2\n    end: Vector2\n    vector: Vector2\n    length: number\n    lengthSquared: number\n    bounds: AABB\n    sign: number // what is this for?\n}\nnamespace Segment {\n    const EPSILON = 0.001\n\n    // Optimized\n    export function create(\n        start: Vector2,\n        end: Vector2\n    ): Segment {\n\n        const dx = end.x - start.x\n        const dy = end.y - start.y\n\n        const lengthSquared =\n            dx ** 2 +\n            dy ** 2\n\n        return {\n            start,\n            end,\n\n            vector: {\n                x: dx,\n                y: dy\n            },\n\n            length: Math.sqrt(lengthSquared),\n\n            lengthSquared,\n\n            bounds: {\n                min: Vector2.create(Math.min(start.x, end.x), Math.min(start.y, end.y)),\n                max: Vector2.create(Math.max(start.x, end.x), Math.max(start.y, end.y))\n            },\n            sign: Math.sign(dy)\n        }\n    }\n\n    export function pointAt(segment: Segment, along: number): Vector2 {\n        return {\n            x: segment.start.x + segment.vector.x * along,\n            y: segment.start.y + segment.vector.y * along\n        }\n    }\n\n    export function getAlong(\n        segment: Segment,\n        point: Vector2\n    ): number {\n        const dx = point.x - segment.start.x\n        const dy = point.y - segment.start.y\n\n        return (\n            dx * segment.vector.x +\n            dy * segment.vector.y\n        ) / segment.lengthSquared\n    }\n\n    // consider rename\n    export function containsPoint(\n        point: Vector2,\n        edge: Segment\n    ): boolean {\n\n        const along =\n            getAlong(edge, point)\n\n        if (\n            along < -EPSILON ||\n            along > 1 + EPSILON\n        ) {\n            return false\n        }\n\n        const projected =\n            pointAt(\n                edge,\n                along\n            )\n\n        return (\n            Math.abs(\n                projected.x - point.x\n            ) <= EPSILON &&\n            Math.abs(\n                projected.y - point.y\n            ) <= EPSILON\n        )\n    }\n    // Optimized: Could be in a segment math namespace\n    export function getRayIntersection(\n        rayStart: Vector2,\n        rayDirection: Vector2,\n        segment: Segment\n    ): number | undefined {\n\n        const toSegmentX = segment.start.x - rayStart.x\n        const toSegmentY = segment.start.y - rayStart.y\n\n        const cross =\n            rayDirection.x * segment.vector.y -\n            rayDirection.y * segment.vector.x\n\n        if (Math.abs(cross) <= EPSILON) {\n            return undefined\n        }\n\n        const t =\n            (\n                toSegmentX * segment.vector.y -\n                toSegmentY * segment.vector.x\n            ) / cross\n\n        if (t < 0) {\n            return undefined\n        }\n\n        const u =\n            (\n                toSegmentX * rayDirection.y -\n                toSegmentY * rayDirection.x\n            ) / cross\n\n        if (u < 0 || u > 1) {\n            return undefined\n        }\n\n        return t\n    }\n\n    export enum Side {\n        Left,\n        Right\n    }\n\n    // Optimized\n    export function getNormal(\n        segment: Segment,\n        side: Side\n    ): Vector2 {\n        const sign: Sign = side === Side.Left ? 1 : -1\n\n        return {\n            x: segment.vector.y * sign / segment.length,\n            y: -segment.vector.x * sign / segment.length\n        }\n    }\n\n    // Optimized: Could be it's own segment Math\n    export function getNormals(\n        segments: Segment[],\n        side: Side\n    ): Vector2[] {\n\n        const normals: Vector2[] = []\n\n        for (const segment of segments) {\n            normals.push(getNormal(segment, side))\n        }\n        return normals\n    }\n\n    export function toLog(segment: Segment): string {\n        const vertices = `Vertices: ${Vector2.toLog(segment.start)} -> ${Vector2.toLog(segment.end)}`\n        const vector = ` | Vector: ${Vector2.toLog(segment.vector)}`\n        const length = ` | length: ${segment.length}, lengthSquared: ${segment.lengthSquared}`\n        const sign = ` | Sign: ${segment.sign}`\n        const bounds = \" | Bounds; \" + AABB.toLog(segment.bounds)\n        return vertices + vector + length + bounds\n    }\n}\n\ninterface Edge extends Segment {\n    index: number\n    startIndex: number\n    endIndex: number\n    normal: Vector2\n}\nnamespace Edge {\n\n    enum Winding {\n        Clockwise,\n        CounterClockwise\n    }\n    export function getWinding(edges: Edge[]): Winding {\n\n        let area = 0\n\n        for (const edge of edges) {\n            area +=\n                edge.start.x * edge.end.y -\n                edge.end.x * edge.start.y\n        }\n\n        return area < 0\n            ? Winding.Clockwise\n            : Winding.CounterClockwise\n    }\n\n    export function create(\n        start: Vector2,\n        end: Vector2,\n        startIndex: number,\n        endIndex: number,\n        index: number,\n        winding: Winding = Winding.Clockwise\n    ): Edge {\n        const segment = Segment.create(start, end)\n        return {\n            start: segment.start,\n            end: segment.end,\n            vector: segment.vector,\n            length: segment.length,\n            lengthSquared: segment.lengthSquared,\n            bounds: segment.bounds,\n            sign: segment.sign,\n            index,\n            startIndex,\n            endIndex,\n            normal: Segment.getNormal(\n                segment,\n                winding === Winding.Clockwise\n                    ? Segment.Side.Left\n                    : Segment.Side.Right\n            )\n        }\n    }\n\n    export function clone(edge: Edge, start: Vector2, end: Vector2): Edge {\n        //const start = startRef === undefined ? Vector2.clone(edge.start) : startRef\n        //const end = endRef === undefined ? Vector2.clone(edge.end) : endRef\n        //const vector = {x: end.x - start.x,y: end.y - start.y}\n\n        const newEdge = {\n            start,\n            end,\n            vector: Vector2.clone(edge.vector),\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: AABB.clone(edge.bounds),\n            sign: edge.sign,\n            index: edge.index,\n            startIndex: edge.startIndex,\n            endIndex: edge.endIndex,\n            normal: Vector2.clone(edge.normal)\n        }\n        return newEdge\n    }\n\n    export function createFromVertices(\n        vertices: Vector2[]\n    ): Edge[] {\n\n        const edges: Edge[] = []\n\n        for (let i = 0; i < vertices.length; i++) {\n            const startIndex = i\n            const endIndex = (i + 1) % vertices.length\n\n            edges.push(\n                create(\n                    vertices[startIndex],\n                    vertices[endIndex],\n                    startIndex,\n                    endIndex,\n                    startIndex\n                )\n            )\n        }\n\n        return edges\n    }\n    export function reverse(edge: Edge): Edge {\n        return {\n            index: edge.index,\n            start: edge.end,\n            end: edge.start,\n\n            vector: {\n                x: -edge.vector.x,\n                y: -edge.vector.y\n            },\n\n            startIndex: edge.endIndex,\n            endIndex: edge.startIndex,\n            length: edge.length,\n            lengthSquared: edge.lengthSquared,\n            bounds: edge.bounds,\n            sign: -edge.sign,\n\n            normal: {\n                x: -edge.normal.x,\n                y: -edge.normal.y\n            }\n        }\n    }\n    export function toLog(edge: Edge): string {\n        const segmentInfo = Segment.toLog(edge)\n\n        const index = ` | StartIndex: ${edge.startIndex}, EndIndex: ${edge.endIndex}`\n        const normal = ` | Normal: ${Vector2.toLog(edge.normal)}`\n        return segmentInfo + index + normal\n    }\n    export function toLogs(edges: Edge[]): string {\n        let logs = \"\"\n        for (const edge of edges) {\n            logs = logs.concat(toLog(edge))\n        }\n\n        return logs\n    }\n}\ntype PointGroup = {\n    direction: Vector2\n    points: Vector2[]\n}\n\ntype PolyBounds = AABB & {\n    boundPoints: PointGroup[]\n}\ninterface Polygon {\n    vertices: Vector2[]\n    origin: Vector2\n    edges: Edge[]\n    bounds: PolyBounds\n}\nnamespace Polygon {\n\n    // POLYGON CREATION \n\n    /**\n     * Creates a regular convex polygon centered at the origin.\n     * Vertices are evenly distributed around the given radius.\n     * Defaults to an upward-facing orientation.\n     */\n    const UP_ANGLE: number = -Math.PI / 2\n    export function create(\n        sides: number,\n        radius: number,\n        rotation?: number,\n        origin: Vector2 = null\n    ): Polygon {\n        if (rotation === undefined) {\n            rotation = UP_ANGLE\n        }\n\n        const verticies: Vector2[] = []\n\n        const angleStep = (Math.PI * 2) / sides\n\n        for (let i = 0; i < sides; i++) {\n            const angle = rotation + i * angleStep\n\n            verticies.push({\n                x: Math.cos(angle) * radius,\n                y: Math.sin(angle) * radius\n            })\n        }\n\n        return createFromVertices(verticies, origin)\n    }\n\n    /**\n     * Creates a polygon from an array of vertices.\n     * Vertices are connected in the order provided,\n     * regardless of their positions.\n     *\n     * Winding direction is determined by vertex order.\n     * Can create concave or self-intersecting polygons.\n     */\n    export function createFromVertices(vertices: Vector2[], origin: Vector2 = null): Polygon {\n        const edges = Edge.createFromVertices(vertices)\n        const bounds = getBounds(vertices)\n        if (!origin) origin = { x: 0, y: 0 }\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function clone(polygon: Polygon): Polygon {\n        let vertices: Vector2[] = []\n        for (let v = 0; v < polygon.vertices.length; v++) {\n            const vertex = polygon.vertices[v]\n            vertices[v] = { x: vertex.x, y: vertex.y }\n        }\n        let edges: Edge[] = []\n        for (let e = 0; e < polygon.edges.length; e++) {\n            const edge = polygon.edges[e]\n            edges.push(Edge.clone(edge, vertices[edge.startIndex], vertices[edge.endIndex]))\n        }\n\n        const bounds = getBounds(vertices)\n        const origin = Vector2.clone(polygon.origin)\n\n        //return polygon\n        return { vertices, origin, edges, bounds }\n    }\n\n    export function createTriangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: 0, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createRectangle(\n        width: number = 16,\n        height: number = 16,\n        origin: Vector2 = null\n    ): Polygon {\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w, y: -h },\n            { x: w, y: -h },\n            { x: w, y: h },\n            { x: -w, y: h }\n        ], origin)\n    }\n\n    export function createOctagon(\n        width: number = 16,\n        height: number = 16,\n        cut: number = 3,\n        origin: Vector2 = null\n    ): Polygon {\n\n        const w = width / 2\n        const h = height / 2\n\n        return createFromVertices([\n            { x: -w + cut, y: -h },\n            { x: w - cut, y: -h },\n            { x: w, y: -h + cut },\n            { x: w, y: h - cut },\n            { x: w - cut, y: h },\n            { x: -w + cut, y: h },\n            { x: -w, y: h - cut },\n            { x: -w, y: -h + cut }\n        ], origin)\n    }\n\n    // POLYGON BOUNDS \n\n\n\n    export function getBounds(vertices: Vector2[]): PolyBounds {\n        let minX = vertices[0].x\n        let maxX = vertices[0].x\n        let minY = vertices[0].y\n        let maxY = vertices[0].y\n\n        let minXPoints = [vertices[0]]\n        let maxXPoints = [vertices[0]]\n        let minYPoints = [vertices[0]]\n        let maxYPoints = [vertices[0]]\n\n        for (let i = 1; i < vertices.length; i++) {\n            const point = vertices[i]\n\n            if (point.x < minX) {\n                minX = point.x\n                minXPoints = [point]\n            } else if (point.x == minX) {\n                minXPoints.push(point)\n            }\n\n            if (point.x > maxX) {\n                maxX = point.x\n                maxXPoints = [point]\n            } else if (point.x == maxX) {\n                maxXPoints.push(point)\n            }\n\n            if (point.y < minY) {\n                minY = point.y\n                minYPoints = [point]\n            } else if (point.y == minY) {\n                minYPoints.push(point)\n            }\n\n            if (point.y > maxY) {\n                maxY = point.y\n                maxYPoints = [point]\n            } else if (point.y == maxY) {\n                maxYPoints.push(point)\n            }\n        }\n\n        const min = Vector2.create(minX, minY)\n        const max = Vector2.create(maxX, maxY)\n        return {\n            min,\n            max,\n\n            boundPoints: [\n                {\n                    direction: { x: -1, y: 0 },\n                    points: minXPoints\n                },\n                {\n                    direction: { x: 1, y: 0 },\n                    points: maxXPoints\n                },\n                {\n                    direction: { x: 0, y: -1 },\n                    points: minYPoints\n                },\n                {\n                    direction: { x: 0, y: 1 },\n                    points: maxYPoints\n                }\n            ]\n        }\n    }\n\n    // POLYGON OPERATIONS\n\n    export function getWidth(vertices: Vector2[]): number {\n        let minX = Infinity\n        let maxX = -Infinity\n\n        for (const vertex of vertices) {\n            minX = Math.min(minX, vertex.x)\n            maxX = Math.max(maxX, vertex.x)\n        }\n\n        return maxX - minX\n    }\n\n    export function getHeight(vertices: Vector2[]): number {\n        let minY = Infinity\n        let maxY = -Infinity\n\n        for (const vertex of vertices) {\n            minY = Math.min(minY, vertex.y)\n            maxY = Math.max(maxY, vertex.y)\n        }\n\n        return maxY - minY\n    }\n\n    export function getArea(vertices: Vector2[]): number {\n        let area = 0\n\n        for (let i = 0; i < vertices.length; i++) {\n            const a = vertices[i]\n            const b = vertices[\n                (i + 1) % vertices.length\n            ]\n\n            area +=\n                a.x * b.y -\n                b.x * a.y\n        }\n\n        return Math.abs(area) * 0.5\n    }\n\n    export function getDepth(\n        verticesA: Vector2[],\n        verticesB: Vector2[],\n        direction: Vector2\n    ): number {\n        let minA =\n            Vector2.dot(\n                verticesA[0],\n                direction\n            )\n\n        let maxB =\n            Vector2.dot(\n                verticesB[0],\n                direction\n            )\n\n        for (let i = 1; i < verticesA.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesA[i],\n                    direction\n                )\n\n            if (projection < minA) {\n                minA = projection\n            }\n        }\n\n        for (let i = 1; i < verticesB.length; i++) {\n\n            const projection =\n                Vector2.dot(\n                    verticesB[i],\n                    direction\n                )\n\n            if (projection > maxB) {\n                maxB = projection\n            }\n        }\n\n\n        return Math.abs(maxB - minA)\n    }\n\n    // TRANSLATE OPERATIONS\n\n    /**\n     * translates/mutates a polygon to a position\n     */\n    export function translateTo(polygon: Polygon, position: Vector2) {\n        const delta = Vector2.subtract(position, polygon.origin)\n        translate(polygon, delta)\n    }\n\n    /**\n     * translates/mutates a polygon by a delta\n     */\n    export function translate(polygon: Polygon, delta: Vector2) {\n        polygon.origin.x += delta.x\n        polygon.origin.y += delta.y\n\n        for (let vertex of polygon.vertices) {\n            vertex.x += delta.x\n            vertex.y += delta.y\n        }\n\n        for (let edge of polygon.edges) {\n            edge.bounds.min.x += delta.x\n            edge.bounds.max.x += delta.x\n            edge.bounds.min.y += delta.y\n            edge.bounds.max.y += delta.y\n        }\n\n        const bounds = polygon.bounds\n\n        bounds.min.x += delta.x\n        bounds.max.x += delta.x\n        bounds.min.y += delta.y\n        bounds.max.y += delta.y\n    }\n\n    /**\n     * Returns a new polygon translated by a delta\n     */\n    export function translated(polygon: Polygon, delta: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translate(newPolygon, delta)\n        return newPolygon\n    }\n    /**\n     * Returns a new polygon translated to a position\n     */\n    export function translatedTo(polygon: Polygon, position: Vector2): Polygon {\n        const newPolygon = clone(polygon)\n        translateTo(newPolygon, position)\n        return newPolygon\n    }\n\n    // LOG OPERATIONS\n\n    export function boundsToLog(shapeName: string, thisBounds: PolyBounds): string {\n        let log = \"BoundingBox \" + shapeName\n\n        const aabb = `| min: ${Vector2.toLog(thisBounds.min)} | max: ${Vector2.toLog(thisBounds.max)}`\n        let logs = ``\n        for (let i = 0; i < thisBounds.boundPoints.length; i++) {\n            logs = logs.concat(`\n            Direction: ${Vector2.toLog(thisBounds.boundPoints[i].direction)}`)\n            let data = \"\"\n            for (let j = 0; j < thisBounds.boundPoints[i].points.length; j++) {\n                const bound = thisBounds.boundPoints[i]\n                data = data.concat(`\n                point[${j}]: ${Vector2.toString(bound.points[j])}`)\n            }\n        }\n    }\n\n    export function toLog(polygon: Polygon): string {\n        const vertices = \" Vertices: \" + Vector2.toLogs(polygon.vertices)\n        const origin = \" | origin: \" + Vector2.toLog(polygon.origin)\n        const edges = \" | Edges: \" + Edge.toLogs(polygon.edges)\n        const bounds = \" | Bounds: \" + AABB.toLog(polygon.bounds)\n        return vertices + origin + edges + bounds\n    }\n}\ninterface AABB {\n    min: Vector2\n    max: Vector2\n}\nnamespace AABB {\n    export function clone(bounds: AABB): AABB {\n        return {\n            min: { x: bounds.min.x, y: bounds.min.y },\n            max: { x: bounds.max.x, y: bounds.max.y }\n        }\n    }\n    export function toLog(bounds: AABB): string {\n        return `min: ${Vector2.toLog(bounds.min)}, max: ${Vector2.toLog(bounds.max)}`\n    }\n}\ninterface Circle {\n    center: Vector2\n    radius: number\n}\nnamespace Circle {\n    export function create(center: Vector2, radius: number): Circle {\n        return {\n            center,\n            radius\n        }\n    }\n\n    export function containsPoint(circle: Circle, point: Vector2): boolean {\n        const dx = point.x - circle.center.x\n        const dy = point.y - circle.center.y\n\n        return dx ** 2 + dy ** 2 <= circle.radius ** 2\n    }\n\n    export function intersects(a: Circle, b: Circle): boolean {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n        const radius = a.radius + b.radius\n\n        return dx ** 2 + dy ** 2 <= radius ** 2\n    }\n\n    export function getMidpoint(a: Circle, b: Circle): Vector2 | null {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distanceSquared = dx ** 2 + dy ** 2\n        const radius = a.radius + b.radius\n        if (distanceSquared > radius ** 2) {\n            return null\n        }\n\n        return {\n            x: (a.center.x + b.center.x) / 2,\n            y: (a.center.y + b.center.y) / 2\n        }\n    }\n\n    export function getPenetration(a: Circle, b: Circle): number {\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx * dx + dy * dy)\n\n        return Math.max(0, a.radius + b.radius - distance)\n    }\n    function getPoints(radius: number): Vector2[] {\n        const points: Vector2[] = []\n\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            points.push({\n                x: Math.cos(radians) * radius,\n                y: Math.sin(radians) * radius\n            })\n        }\n\n        return points\n    }\n    export function getNormal(\n        a: Circle,\n        b: Circle\n    ): Vector2 {\n\n        const dx = b.center.x - a.center.x\n        const dy = b.center.y - a.center.y\n\n        const distance = Math.sqrt(dx ** 2 + dy ** 2)\n        if (distance === 0) {\n            return { x: 1, y: 0 }\n        }\n\n        return {\n            x: dx / distance,\n            y: dy / distance\n        }\n    }\n\n    export function getBounds(circle: Circle): AABB {\n        return {\n            min: {\n                x: circle.center.x - circle.radius,\n                y: circle.center.y - circle.radius\n            },\n            max: {\n                x: circle.center.x + circle.radius,\n                y: circle.center.y + circle.radius\n            }\n        }\n    }\n}\n\n","test.ts":"// Add your code here\nlet circles: Circle[] = []\nlet circleVs: Vector2[] = []\nlet rendered = 0\nfunction MakeCircle() {\n    let circle = Circle.create({ x: 1, y: 1 }, 2)\n    circles.push(circle)\n    circleVs.push(Vector2.create(20, 0))\n\n    scene.createRenderable(0, () => {\n        screen.setPixel(circle.center.x, circle.center.y, 1)\n    })\n    if (rendered >= 0) return\n    rendered++\n    scene.createRenderable(0, () => {\n        for (let angle = 0; angle < 360; angle++) {\n            const radians = angle * Math.PI / 180\n\n            const x = circle.center.x + circle.radius * Math.cos(radians)\n            const y = circle.center.y + circle.radius * Math.sin(radians)\n\n            screen.setPixel(Math.floor(x), Math.floor(y), 1)\n        }\n    })\n}\n\n\n\nfunction CircleTest() {\n    game.stats = true\n    let count = 0\n    const display = sprites.create(img`\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n    `)\n    display.x = 100\n    display.y = 40\n    game.onUpdateInterval(500, function () {\n        MakeCircle()\n        count++\n        display.sayText(count.toString())\n    })\n\n    const gravity = 300\n\n    game.onUpdate(function () {\n        const dt = control.eventContext().deltaTime\n\n        for (let i = 0; i < circles.length; i++) {\n\n            const circle = circles[i]\n            const velocity = circleVs[i]\n\n            velocity.y += gravity * dt\n\n            const position = circle.center\n\n            position.x += velocity.x * dt\n            position.y += velocity.y * dt\n\n\n        }\n    })\n    const iterations = 6\n    game.onUpdate(function () {\n        for (let iteration = 0; iteration < iterations; iteration++) {\n            for (let i = 0; i < circles.length; i++) {\n                const circle = circles[i]\n                const velocity = circleVs[i]\n                const position = circle.center\n\n                // Screen boundaries\n                if (position.x < circle.radius) {\n                    position.x = circle.radius\n                    if (velocity.x < 0) velocity.x *= -0.5\n                }\n                else if (position.x > 160 - circle.radius) {\n                    position.x = 160 - circle.radius\n                    if (velocity.x > 0) velocity.x *= -0.5\n                }\n\n                if (position.y < circle.radius) {\n                    position.y = circle.radius\n                    if (velocity.y < 0) velocity.y *= -0.5\n                }\n                else if (position.y > 120 - circle.radius) {\n                    position.y = 120 - circle.radius\n                    if (velocity.y > 0) velocity.y *= -0.5\n                }\n\n                // Circle collisions\n                for (let j = i + 1; j < circles.length; j++) {\n                    const otherCircle = circles[j]\n                    const otherVelocity = circleVs[j]\n\n                    const pen = Circle.getPenetration(circle, otherCircle)\n                    if (pen <= 0) continue\n\n                    const dir = Circle.getNormal(circle, otherCircle)\n                    const correction = pen * 0.5\n\n                    circle.center.x -= dir.x * correction\n                    circle.center.y -= dir.y * correction\n                    otherCircle.center.x += dir.x * correction\n                    otherCircle.center.y += dir.y * correction\n\n                    // Velocity response\n                    const rvx = otherVelocity.x - velocity.x\n                    const rvy = otherVelocity.y - velocity.y\n                    const alongNormal = rvx * dir.x + rvy * dir.y\n\n                    if (alongNormal < 0) {\n                        const impulse = -(1 + 0.5) * alongNormal * 0.5\n\n                        velocity.x -= impulse * dir.x\n                        velocity.y -= impulse * dir.y\n\n                        otherVelocity.x += impulse * dir.x\n                        otherVelocity.y += impulse * dir.y\n                    }\n                }\n            }\n        }\n    })\n}\n\nCircleTest()","pxt.json":"{\n    \"name\": \"TSKit\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"core.ts\",\n        \"advMath.ts\",\n        \"test.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794522946365}